<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap uap5 rescap desktop virtualization com systemai">

  <!-- Version = MARKETING_VERSION of project.yml + ".0" (scripts/bump-version.sh: macOS and Windows share one
       version). CI patches it: 0.0.<run number>.0 in CI builds, X.Y.Z.0 from the release tag. -->
  <Identity
    Name="dinh.thi.EchoDiar"
    Publisher="CN=EchoDiar Dev"
    Version="1.5.3.0" />

  <Properties>
    <DisplayName>EchoDiar</DisplayName>
    <PublisherDisplayName>Anh-Thi Dinh</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Flexible virtualization (Windows 11): only the library, %LOCALAPPDATA%\EchoDiar, is written for real, so it
         stays after uninstall and Explorer sees it. Every other AppData and HKCU write stays virtualized.
         PackageManifestTests guards this. -->
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\EchoDiar</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <!-- Whisper.net and LLamaSharp natives (whisper, ggml*, llama) are MSVC-built: this framework puts
         msvcp140, vcruntime140(_1) and vcomp140 on the package's DLL search path. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00.UWPDesktop"
      MinVersion="14.0.33728.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="EchoDiar"
        Description="EchoDiar"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Generated from assets/logo.png by windows/tools/make-icons.sh (scale and targetsize qualified files). -->
        <uap:DefaultTile
          ShortName="EchoDiar"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="EchoDiar.App.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="echodiar.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- Launch at login (Settings > General, Platform LaunchAtLogin); off until the user turns it on. -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="EchoDiar.App.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="EchoDiarStartup"
            Enabled="false"
            DisplayName="EchoDiar" />
        </uap5:Extension>
        <!-- Notification clicks (the end prompt's Stop now / Keep recording, App RegisterNotifications): Windows App SDK
             AppNotificationManager activates the app through this COM server; the same CLSID in both entries. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="EchoDiar.App.exe" Arguments="----AppNotificationActivated:" DisplayName="EchoDiar">
              <com:Class Id="6656F0EB-4750-4DFE-AB6E-B1E287EF9BA0" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="6656F0EB-4750-4DFE-AB6E-B1E287EF9BA0" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Calendar (Windows.ApplicationModel.Appointments): read the user's calendars, write the app's own. -->
    <uap:Capability Name="appointments" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Required by the ExcludedDirectory above, and used for that one folder only. -->
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- Settings › About and the Update button install the update from the .appinstaller (PackageManager). -->
    <rescap:Capability Name="packageManagement" />
    <!-- Phi Silica (Windows AI) on Copilot+ PCs. -->
    <systemai:Capability Name="systemAIModels" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
