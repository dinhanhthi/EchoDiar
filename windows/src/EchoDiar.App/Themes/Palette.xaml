<?xml version="1.0" encoding="utf-8"?>
<!-- The app colors, corner radii and motion (macOS GlassStyle.swift: Palette, Motion). Dark only: one value each. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cards and panels, a step above the window. -->
    <SolidColorBrush x:Key="PaletteSurfaceBrush" Color="#2C2C2E" />
    <!-- Text fields and input bars, a step above the cards. -->
    <SolidColorBrush x:Key="PaletteInputSurfaceBrush" Color="#3A3A3C" />
    <!-- The 1 px edge of cards, panels and capsules (white at 0.08). -->
    <SolidColorBrush x:Key="PaletteSurfaceBorderBrush" Color="#14FFFFFF" />
    <!-- Hover and pressed highlights (white at 0.1 and 0.2). -->
    <SolidColorBrush x:Key="PaletteHoverFillBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PalettePressedFillBrush" Color="#33FFFFFF" />

    <CornerRadius x:Key="CornerRadiusXLarge">20</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusSmall">10</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXSmall">8</CornerRadius>

    <!-- Pages, tabs, panels, lists and the pill: 250 ms with a snappy curve (fast start, no bounce). -->
    <x:String x:Key="MotionStandardDuration">00:00:00.250</x:String>
    <x:String x:Key="MotionSnappyKeySpline">0.1,0.9 0.2,1</x:String>
    <!-- Hover highlights: 120 ms ease-out. -->
    <x:String x:Key="MotionHoverDuration">00:00:00.120</x:String>
    <x:String x:Key="MotionHoverKeySpline">0,0,0.58,1</x:String>
</ResourceDictionary>
