<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoDiar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EchoDiar.App.Views"
    Title="EchoDiar">

    <!-- The theme's solid background where no system backdrop is set; cleared in code under Mica or Acrylic. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the whole row drags the window except the toolbar's controls (passthrough regions). -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <views:TitleBarToolbar x:Name="Toolbar" Grid.Column="1" />
        </Grid>

        <!-- GlobalTapNote (macOS MainView.swift): before recording, the picked app cannot be recorded on its own. -->
        <Grid
            x:Name="GlobalTapNote"
            Grid.Row="1"
            Margin="12,12,12,0"
            ColumnSpacing="6"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE946;" />
            <TextBlock
                x:Name="GlobalTapNoteText"
                Grid.Column="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </Grid>

        <!--
            Compact (the list route): the library fills the window. Wide (a conversation, the recording): the same
            library as a 360 px sidebar, then the route's page.
        -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <ContentControl
                x:Name="ListHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False" />

            <!-- The recording page or one conversation. -->
            <ContentControl
                x:Name="RouteHost"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
