<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoDiar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EchoDiar">

    <!-- Transparent so the tinted Mica backdrop shows through. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the whole row drags the window except the capsule (passthrough region). -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ToolbarCapsule"
                Grid.Column="1"
                Margin="12,0,0,0"
                Height="32"
                Padding="1"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="#2C2C2E"
                BorderBrush="#14FFFFFF"
                BorderThickness="1">
                <Border.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <Style x:Key="CapsuleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="14" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource CapsuleButtonStyle}"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource CapsuleButtonStyle}"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24" Spacing="6">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Library folder" />
            <TextBlock x:Name="DataRootText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
