<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoDiar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EchoDiar.App.Views"
    Title="EchoDiar">

    <!-- Transparent so the tinted Mica backdrop shows through. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the whole row drags the window except the toolbar's controls (passthrough regions). -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <views:TitleBarToolbar x:Name="Toolbar" Grid.Column="1" />
        </Grid>

        <!-- The current route's page: the library list, the recording page or one conversation. -->
        <ContentControl
            x:Name="RouteHost"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False" />
    </Grid>
</Window>
