<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EchoDiar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EchoDiar.App.Views"
    Title="EchoDiar">

    <!-- The theme's solid background where no system backdrop is set; cleared in code under Mica or Acrylic. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header on the window's backdrop, like Paint: the title row (the title bar) and the toolbar row. -->
        <views:TitleBarToolbar x:Name="Toolbar" />

        <!-- The body on its own layer, a line below the header (the Windows 11 layer on Mica). -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- GlobalTapNote (macOS MainView.swift): before recording, the picked app cannot be recorded on its own. -->
                <InfoBar
                    x:Name="GlobalTapNote"
                    Margin="12,12,12,0"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Visibility="Collapsed" />

                <!--
                    The library as a 360 px sidebar, then the detail: a conversation, the recording, or the welcome pane
                    when nothing is open. Settings: its page alone, with its own sidebar.
                -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="360" />
                        <ColumnDefinition x:Name="DetailColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <ContentControl
                        x:Name="ListHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False" />

                    <!-- The recording page, one conversation, the welcome pane or Settings. -->
                    <ContentControl
                        x:Name="RouteHost"
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
