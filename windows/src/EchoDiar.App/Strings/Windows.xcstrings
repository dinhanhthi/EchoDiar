    "Audio leaves this PC: cloud engines upload the recording to the provider." : {
      "comment" : "Windows only: Views/Settings/TranscriptionSettingsPage.xaml.cs.",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
