  "strings" : {
    "\"Tell speakers apart\" is on. Download a model to tell the other speakers apart." : {
      "comment" : "Windows only: Views/ConversationListView.xaml.cs.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Distinguir hablantes\" está activado. Descarga un modelo para distinguir a los demás hablantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"Distinguer les intervenants\" est activé. Téléchargez un modèle pour distinguer les autres intervenants."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"Phân biệt người nói\" đang bật. Hãy tải về một mô hình để phân biệt những người nói khác."
