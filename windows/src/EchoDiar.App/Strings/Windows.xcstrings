    },
    "%@ not saved: put the key in the API key field, which keeps it in Credential Manager." : {
      "comment" : "Windows only: Views/Settings/ProvidersSettingsPage.xaml.cs.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ha guardado: pon la clave en el campo Clave de API, que la guarda en el Administrador de credenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non enregistré : saisissez la clé dans le champ Clé API, qui la conserve dans le Gestionnaire d’identification."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ chưa được lưu: hãy nhập khoá vào ô Khoá API, nơi khoá được giữ trong Trình quản lý thông tin xác thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未保存 %@：请将密钥填入“API 密钥”栏，它会保存在凭据管理器中。"
          }
        }
      }
    },
