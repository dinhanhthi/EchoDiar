    },
    "%@ failed its integrity check. Download it again." : {
      "comment" : "Windows only: Services/AppServices.cs, ViewModels/AppViewModel.AI.cs.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha superado la comprobación de integridad. Vuelve a descargarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ n’a pas passé le contrôle d’intégrité. Téléchargez-le à nouveau."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ không vượt qua bước kiểm tra tính toàn vẹn. Hãy tải về lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未通过完整性检查。请重新下载。"
