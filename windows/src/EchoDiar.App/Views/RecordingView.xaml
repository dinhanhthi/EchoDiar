<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording page (macOS RecordingViews.swift RecordingDetailView and RecordingHeader): the header with the
    title, the state, the elapsed time, the mic and system meters, "Catch up" and the language, the calendar suggestion
    and the capture warnings, pinned on every tab and in both layouts; under them the tab's content: the live
    transcript (or the wave and why there is none), the catch-ups, or the live chat; side by side, the transcript on
    the left and the catch-ups or the chat on the right.
-->
<UserControl
    x:Class="EchoDiar.App.Views.RecordingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <!--
            RecordingWave: the system accent while recording, the disabled text colour while paused; ThemeResources, so
            a theme switch repaints the bars even while they stand still.
        -->
        <Style x:Key="WaveBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="PausedWaveBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
        </Style>
        <!-- A card: the catch-ups in the Tabs layout, the right panel side by side (set in code). -->
        <Style x:Key="PaneStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <StackPanel Spacing="10">
                <!-- The title, saved as it changes (set in code: the model holds it trimmed). -->
                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.Name="{local:T Text='Title'}"
                    PlaceholderText="{local:T Text='Add a title'}" />
                <Grid x:Name="StatusRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <FontIcon
                            x:Name="RecordingIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE7C8;" />
                        <FontIcon
                            x:Name="PausedIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE769;"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock
                        x:Name="ElapsedText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="StateText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!--
                        ChannelMeters: mic over system, 120 px wide, the labels at least 44 px; side by side, the bars
                        72 px wide, where the row has room (set in code: ApplyMetersLayout).
                    -->
                    <StackPanel
                        x:Name="ChannelMeters"
                        Grid.Column="4"
                        Width="120"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <Grid x:Name="MicMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MicLabelColumn" Width="Auto" MinWidth="44" />
                                <ColumnDefinition x:Name="MicBarColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="MicLabel"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='Mic'}" />
                            <Border
                                x:Name="MicTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="MicFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                        <Grid x:Name="SystemMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SystemLabelColumn" Width="Auto" MinWidth="44" />
                                <ColumnDefinition x:Name="SystemBarColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="SystemLabel"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='System'}" />
                            <Border
                                x:Name="SystemTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="SystemFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!--
                        "Catch up": its help as the button's tooltip; the reason it is off as the host's, as a disabled
                        button shows none; Transparent, so the host is hit-tested under the disabled button.
                    -->
                    <Border
                        x:Name="CatchUpButtonHost"
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <Button x:Name="CatchUpButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8FD;" />
                                <TextBlock Text="{local:T Text='Catch up'}" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- The language menu, set in code. -->
                    <ContentPresenter x:Name="LanguageHost" Grid.Column="6" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- The calendar event the recording likely belongs to: Rename links it and takes its title, Not now stops suggesting it. -->
        <InfoBar
            x:Name="SuggestionBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.IconSource>
                <SymbolIconSource Symbol="Calendar" />
            </InfoBar.IconSource>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AcceptSuggestionButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{local:T Text='Rename'}" />
                    <Button x:Name="DismissSuggestionButton" Content="{local:T Text='Not now'}" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- The picked app could not be isolated: every process except EchoDiar is recorded. -->
        <InfoBar
            x:Name="GlobalTapWarning"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!-- SilentTapBanner: the app plays but the capture hears only silence. -->
        <InfoBar
            x:Name="SilentTapBanner"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Title="{local:T Text='No system audio'}" />

        <!--
            The tab's content (AppViewModel.RecordingTab), placed in code by Settings.RecordingLayout: Tabs, the
            transcript or the panel across the width; side by side, the transcript on the left and the panel on the
            right, in a card, with its own Catch-up | Chat tabs (Transcript shown as Catch-up).
        -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The live transcript, or the wave and why there is none; kept while hidden (its view holds the stream). -->
            <Grid x:Name="TranscriptPane" Grid.ColumnSpan="2">
                <!-- LiveTranscriptView, set in code; shown while the recording has a live transcriber. -->
                <Border x:Name="LiveHost" Visibility="Collapsed" />

                <StackPanel
                    x:Name="NoLivePanel"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <!-- RecordingWave: 24 bars, built in code. -->
                    <StackPanel
                        x:Name="Wave"
                        Height="64"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Orientation="Horizontal"
                        Spacing="4" />
                    <TextBlock
                        x:Name="ReasonText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!-- Opens the Settings page the reason names. -->
                    <HyperlinkButton
                        x:Name="OpenSettingsLink"
                        HorizontalAlignment="Center"
                        Content="{local:T Text='Open Settings'}" />
                </StackPanel>
            </Grid>

            <!-- The catch-ups or the chat; side by side, one card with the Catch-up | Chat tabs over them. -->
            <Border x:Name="SidePanel" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SelectorBar
                        x:Name="PanelTabsBar"
                        Margin="0,10"
                        Padding="0"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                        <SelectorBarItem x:Name="CatchUpPanelTab" Text="{local:T Text='Catch-up'}" />
                        <SelectorBarItem x:Name="ChatPanelTab" Text="{local:T Text='Chat'}" />
                    </SelectorBar>

                    <!--
                        The catch-ups (CatchUpCard, set in code), newest first, filling the tab, in a card of their own
                        in the Tabs layout; while there are none, a hint to press Catch up.
                    -->
                    <Border x:Name="CatchUpPanel" Grid.Row="1" Style="{StaticResource PaneStyle}">
                        <Grid>
                            <TextBlock
                                x:Name="CatchUpEmptyText"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Text="{local:T Text='No catch-up yet. Press Catch up to summarize the meeting so far.'}" />
                            <ScrollViewer x:Name="CatchUpScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="CatchUpCards" Padding="8" Spacing="6" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- LiveChatView, made in code while the Chat tab is shown. -->
                    <Border x:Name="ChatHost" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
