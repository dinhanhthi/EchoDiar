<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EchoDiar.App.Views.RecordingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="560"
            Padding="24,8,24,24"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Record" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="TargetPicker" MinWidth="320" Header="Record from" />
                <Button
                    x:Name="RefreshButton"
                    VerticalAlignment="Bottom"
                    Click="OnRefreshClick"
                    Content="Refresh apps" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="StartButton"
                    Click="OnStartClick"
                    Content="Start"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="PauseButton" Click="OnPauseClick" Content="Pause" />
                <Button x:Name="StopButton" Click="OnStopClick" Content="Stop" />
            </StackPanel>

            <TextBlock x:Name="ElapsedText" Style="{StaticResource SubtitleTextBlockStyle}" Text="0:00" />

            <StackPanel Spacing="4">
                <TextBlock Text="Microphone" />
                <ProgressBar x:Name="MicLevelBar" Maximum="1" AutomationProperties.Name="Microphone level" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="System audio" />
                <ProgressBar x:Name="SystemLevelBar" Maximum="1" AutomationProperties.Name="System audio level" />
            </StackPanel>

            <TextBlock
                x:Name="WarningText"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
