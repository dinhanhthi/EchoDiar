<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording page (macOS RecordingViews.swift RecordingDetailView and RecordingHeader): the header with the
    state, the elapsed time, the mic and system meters and the language, the capture warnings, then the wave and why
    there is no live transcript (Phase 16 shows the live transcript in its place).
-->
<UserControl
    x:Class="EchoDiar.App.Views.RecordingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="14,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center">
                    <FontIcon
                        x:Name="RecordingIcon"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE7C8;" />
                    <FontIcon
                        x:Name="PausedIcon"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE769;"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    x:Name="ElapsedText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="StateText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- ChannelMeters: mic over system, 110 px wide. -->
                <StackPanel
                    x:Name="ChannelMeters"
                    Grid.Column="4"
                    Width="110"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <Grid x:Name="MicMeter" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Mic" />
                        <Border
                            x:Name="MicTrack"
                            Grid.Column="1"
                            Height="5"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                            CornerRadius="2.5">
                            <Border
                                x:Name="MicFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                CornerRadius="2.5" />
                        </Border>
                    </Grid>
                    <Grid x:Name="SystemMeter" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="System" />
                        <Border
                            x:Name="SystemTrack"
                            Grid.Column="1"
                            Height="5"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                            CornerRadius="2.5">
                            <Border
                                x:Name="SystemFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                CornerRadius="2.5" />
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- The language menu, set in code. -->
                <ContentPresenter x:Name="LanguageHost" Grid.Column="5" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- The picked app could not be isolated: every process except EchoDiar is recorded. -->
        <Grid
            x:Name="GlobalTapWarning"
            Grid.Row="1"
            ColumnSpacing="6"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xE7BA;" />
            <TextBlock
                x:Name="GlobalTapText"
                Grid.Column="1"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap" />
        </Grid>

        <!-- SilentTapBanner: the app plays but the capture hears only silence. -->
        <Border
            x:Name="SilentTapBanner"
            Grid.Row="2"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE74F;" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='No system audio'}" />
                    <TextBlock
                        x:Name="SilentTapText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="3"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <!-- RecordingWave: 24 bars, built in code. -->
            <StackPanel
                x:Name="Wave"
                Height="64"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Orientation="Horizontal"
                Spacing="4" />
            <TextBlock
                x:Name="ReasonText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <!-- Settings comes with Phase 13, which opens the page the reason names. -->
            <HyperlinkButton
                HorizontalAlignment="Center"
                Content="{local:T Text='Open Settings'}"
                IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
