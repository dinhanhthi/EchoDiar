<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording page (macOS RecordingViews.swift RecordingDetailView and RecordingHeader): the header with the
    title, the state, the elapsed time, the mic and system meters and the language, the calendar suggestion, the capture
    warnings, then the live transcript, or the wave and why there is none.
-->
<UserControl
    x:Class="EchoDiar.App.Views.RecordingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <!--
            RecordingWave: the system accent while recording, the disabled text colour while paused; ThemeResources, so
            a theme switch repaints the bars even while they stand still.
        -->
        <Style x:Key="WaveBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="PausedWaveBarStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="16,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <StackPanel Spacing="10">
                <!-- The title, saved as it changes (set in code: the model holds it trimmed). -->
                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.Name="{local:T Text='Title'}"
                    PlaceholderText="{local:T Text='Add a title'}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <FontIcon
                            x:Name="RecordingIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE7C8;" />
                        <FontIcon
                            x:Name="PausedIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE769;"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock
                        x:Name="ElapsedText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="StateText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- ChannelMeters: mic over system, 120 px wide. -->
                    <StackPanel
                        x:Name="ChannelMeters"
                        Grid.Column="4"
                        Width="120"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <Grid x:Name="MicMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='Mic'}" />
                            <Border
                                x:Name="MicTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="MicFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                        <Grid x:Name="SystemMeter" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                Text="{local:T Text='System'}" />
                            <Border
                                x:Name="SystemTrack"
                                Grid.Column="1"
                                Height="5"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                CornerRadius="2.5">
                                <Border
                                    x:Name="SystemFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2.5" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- The language menu, set in code. -->
                    <ContentPresenter x:Name="LanguageHost" Grid.Column="5" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- The calendar event the recording likely belongs to: Rename links it and takes its title, Not now stops suggesting it. -->
        <InfoBar
            x:Name="SuggestionBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.IconSource>
                <SymbolIconSource Symbol="Calendar" />
            </InfoBar.IconSource>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AcceptSuggestionButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{local:T Text='Rename'}" />
                    <Button x:Name="DismissSuggestionButton" Content="{local:T Text='Not now'}" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- The picked app could not be isolated: every process except EchoDiar is recorded. -->
        <InfoBar
            x:Name="GlobalTapWarning"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <!-- SilentTapBanner: the app plays but the capture hears only silence. -->
        <InfoBar
            x:Name="SilentTapBanner"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning"
            Title="{local:T Text='No system audio'}" />

        <!-- LiveTranscriptView, set in code; shown while the recording has a live transcriber. -->
        <Border x:Name="LiveHost" Grid.Row="4" Visibility="Collapsed" />

        <StackPanel
            x:Name="NoLivePanel"
            Grid.Row="4"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <!-- RecordingWave: 24 bars, built in code. -->
            <StackPanel
                x:Name="Wave"
                Height="64"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Orientation="Horizontal"
                Spacing="4" />
            <TextBlock
                x:Name="ReasonText"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <!-- Opens the Settings page the reason names. -->
            <HyperlinkButton
                x:Name="OpenSettingsLink"
                HorizontalAlignment="Center"
                Content="{local:T Text='Open Settings'}" />
        </StackPanel>
    </Grid>
</UserControl>
