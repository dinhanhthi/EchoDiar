<?xml version="1.0" encoding="utf-8"?>
<!--
    One catch-up (macOS CatchUpPanel.swift CatchUpCardView), on the recording page and in the AI pane: the header
    (chevron, "Catch-up at m:ss", the provider, the model and "Stopped", then Stop or Copy) and, open, the text: a
    placeholder until it comes, its Markdown, the error under it.
-->
<UserControl
    x:Class="EchoDiar.App.Views.CatchUpCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <Border
        Padding="4,4,8,8"
        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource ControlCornerRadius}">
        <StackPanel Spacing="4">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Opens or closes the card. -->
                <Button
                    x:Name="HeaderButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource SubtleButtonStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="Chevron"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE70D;" />
                        <TextBlock
                            x:Name="TitleText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="DetailsText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </Button>
                <Button
                    x:Name="StopButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{local:T Text='Stop'}"
                    ToolTipService.ToolTip="{local:T Text='Stop the catch-up and keep what is written'}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CopyButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="CopyIcon"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE8C8;" />
                </Button>
            </Grid>

            <StackPanel x:Name="Body" Padding="12,0,0,0" Spacing="6">
                <!-- Until the first text: the status, its ring only after 150 ms. -->
                <StackPanel
                    x:Name="Placeholder"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="PlaceholderRing"
                        Width="16"
                        Height="16"
                        IsActive="False"
                        Opacity="0" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <RichTextBlock x:Name="MarkdownText" Visibility="Collapsed" />
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    MaxLines="4"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
