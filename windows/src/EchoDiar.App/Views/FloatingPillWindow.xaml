<?xml version="1.0" encoding="utf-8"?>
<!--
    The floating pill (macOS FloatingPillView.swift): the logo, the recording dot, "Recording <App>" after an automatic
    start, the elapsed time, a level meter and a muted mic's glyph; Pause or Resume, Mute or Unmute, Stop and the
    language menu while the pointer is over it.
    A meeting prompt takes the indicator's place. The capsule sizes to its content inside a Canvas, so its size is
    the window's, which the controller sets; the window's region clips it to the capsule. Its buttons never take the
    focus: focus would activate the window, which would then take the foreground (and Alt+F4) from the meeting app.
-->
<Window
    x:Class="EchoDiar.App.Views.FloatingPillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    Title="EchoDiar">

    <Canvas x:Name="RootCanvas" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid
            x:Name="Capsule"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1">
            <StackPanel x:Name="Indicator" VerticalAlignment="Center" Orientation="Horizontal">
                <Image
                    x:Name="Logo"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Square44x44Logo.png" />
                <Grid x:Name="DotGrid" VerticalAlignment="Center">
                    <Ellipse x:Name="RecordingDot" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Ellipse
                        x:Name="PausedDot"
                        Fill="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    x:Name="SourceText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    Visibility="Collapsed" />
                <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <!-- The elapsed time in the paused dot's colour. -->
                <TextBlock
                    x:Name="PausedElapsedText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Visibility="Collapsed" />
                <!-- The louder channel's peak. -->
                <Border
                    x:Name="MeterTrack"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}">
                    <Border
                        x:Name="MeterFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Border>
                <!-- The mic is muted; expanded, the Mute button shows it. -->
                <FontIcon
                    x:Name="MutedIcon"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{local:T Text='Microphone muted'}"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xF781;"
                    Visibility="Collapsed" />
                <!-- Shown while the pointer is over the pill. -->
                <StackPanel x:Name="Controls" Orientation="Horizontal" Visibility="Collapsed">
                    <Button
                        x:Name="PauseButton"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        MinWidth="0"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon x:Name="PauseIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE769;" />
                    </Button>
                    <Button
                        x:Name="MuteButton"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        MinWidth="0"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon x:Name="MuteIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE720;" />
                    </Button>
                    <Button
                        x:Name="StopButton"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        MinWidth="0"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Stop'}"
                        ToolTipService.ToolTip="{local:T Text='Stop recording'}">
                        <FontIcon
                            x:Name="StopIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE71A;" />
                    </Button>
                    <Button
                        x:Name="LanguageButton"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False"
                        MinWidth="0"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Language'}"
                        ToolTipService.ToolTip="{local:T Text='Language from now on'}">
                        <FontIcon x:Name="GlobeIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE774;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="LanguageMenu" Placement="Bottom" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
            <!--
                A prompt (macOS detectedPrompt and endPrompt): the logo, the question, the end prompt's countdown and
                its buttons. The texts and which buttons show are set in code.
            -->
            <Grid
                x:Name="PromptHost"
                Padding="0,10"
                ColumnSpacing="10"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Square44x44Logo.png" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock
                        x:Name="PromptText"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="CountdownText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Detected: Record, Not now, Always for <App> (not for browsers). -->
                        <Button
                            x:Name="RecordPromptButton"
                            AllowFocusOnInteraction="False"
                            Content="{local:T Text='Record'}"
                            IsTabStop="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="NotNowButton"
                            AllowFocusOnInteraction="False"
                            Content="{local:T Text='Not now'}"
                            IsTabStop="False" />
                        <Button
                            x:Name="AlwaysButton"
                            AllowFocusOnInteraction="False"
                            IsTabStop="False" />
                        <!-- Ended: Keep recording, Stop now (the default: the countdown ends in a stop). -->
                        <Button
                            x:Name="KeepRecordingButton"
                            AllowFocusOnInteraction="False"
                            Content="{local:T Text='Keep recording'}"
                            IsTabStop="False" />
                        <Button
                            x:Name="StopNowButton"
                            AllowFocusOnInteraction="False"
                            Content="{local:T Text='Stop now'}"
                            IsTabStop="False"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Canvas>
</Window>
