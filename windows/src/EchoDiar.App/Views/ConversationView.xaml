<?xml version="1.0" encoding="utf-8"?>
<!--
    One conversation beside the wide layout's sidebar: its title (double-click to rename) and details, then the
    toolbar's tab. Transcript is TranscriptView with playback; Summary and Chat say how to set up AI until Phase 24.
-->
<UserControl
    x:Class="EchoDiar.App.Views.ConversationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    xmlns:views="using:EchoDiar.App.Views">

    <Grid Margin="0,8,12,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="4,0" Spacing="2">
            <Grid>
                <TextBlock
                    x:Name="TitleText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <!-- Enter saves a changed title; Esc or a click elsewhere cancels. -->
                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.Name="{local:T Text='Title'}"
                    PlaceholderText="{local:T Text='Title'}"
                    Visibility="Collapsed" />
            </Grid>
            <TextBlock
                x:Name="DetailText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <views:TranscriptView x:Name="TranscriptPane" Grid.Row="1" />

        <!-- Summary and Chat: Phase 24 brings the AI panel. -->
        <Border
            x:Name="AIPane"
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Visibility="Collapsed">
            <Grid
                MaxWidth="480"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,3,0,0"
                    VerticalAlignment="Top"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{local:T Text='No AI model: set up a provider or download a model in Settings › AI.'}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
