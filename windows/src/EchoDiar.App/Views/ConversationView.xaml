<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EchoDiar.App.Views.ConversationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EchoDiar.App.Views">

    <!-- The page on a Fluent card beside the wide layout's sidebar; Phase 13 completes the transcript view. -->
    <Border
        Margin="0,8,12,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="PlayButton"
                    Click="OnPlayClick"
                    Content="Play"
                    IsEnabled="False" />
                <TextBlock
                    x:Name="TimeText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="TranscribeButton"
                    Click="OnTranscribeClick"
                    Content="Transcribe"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8">
                <ProgressBar x:Name="JobBar" Maximum="1" Visibility="Collapsed" />
                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="3"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />

            <!--
                One line per segment (the speaker, the time, the text); clicking a line plays from it, the line under the
                play head is selected (the ListView's subtle fill and accent bar).
            -->
            <ListView
                x:Name="LineList"
                Grid.Row="3"
                IsItemClickEnabled="True"
                ItemClick="OnLineClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:TranscriptLine">
                        <StackPanel Padding="0,6" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Speaker}"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Time}"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Text}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
