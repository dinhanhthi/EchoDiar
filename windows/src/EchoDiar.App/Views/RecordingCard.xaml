<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording in the library, above the conversations (macOS RecordingViews.swift RecordingCard): the source,
    "Recording…" or "Paused", the elapsed time and mini meters, then a row with Stop and Pause or Resume. The compact
    card (the wide layout's sidebar) drops the row; the context menu keeps Stop and Pause. A click opens the recording
    page; selected (that page is shown) adds the accent fill and edge.
-->
<UserControl
    x:Class="EchoDiar.App.Views.RecordingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <Grid Margin="0,3">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="CardMenu">
                <MenuFlyoutItem x:Name="StopItem" Text="{local:T Text='Stop'}" />
                <MenuFlyoutItem x:Name="PauseItem" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}" />
        <Border
            x:Name="SelectionFill"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Opacity="0.18"
            Visibility="Collapsed" />

        <Grid x:Name="ContentGrid" Padding="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Windows has no app icon here yet: the speaker stands for the recorded source. -->
            <FontIcon
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE767;" />

            <StackPanel Grid.Column="1" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Grid VerticalAlignment="Center">
                        <Ellipse
                            x:Name="RecordingDot"
                            Width="8"
                            Height="8"
                            Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Ellipse
                            x:Name="PausedDot"
                            Width="8"
                            Height="8"
                            Fill="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock
                        x:Name="StateText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ElapsedText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- Mic over system, 44 px wide. -->
                    <StackPanel
                        x:Name="MiniMeters"
                        Grid.Column="1"
                        Width="44"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Spacing="2">
                        <Border Height="3" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" CornerRadius="1.5">
                            <Border
                                x:Name="MicFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.5" />
                        </Border>
                        <Border Height="3" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" CornerRadius="1.5">
                            <Border
                                x:Name="SystemFill"
                                Width="0"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.5" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="SourceText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Stop, Pause or Resume, then the language menu (added in code). -->
                <StackPanel
                    x:Name="ButtonRow"
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="StopButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Stop'}"
                        ToolTipService.ToolTip="{local:T Text='Stop recording'}">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="15"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE71A;" />
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon
                            x:Name="PauseIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="15"
                            Glyph="&#xE769;" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border
            x:Name="SelectionStroke"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
