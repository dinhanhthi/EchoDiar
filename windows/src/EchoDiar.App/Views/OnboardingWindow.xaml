<?xml version="1.0" encoding="utf-8"?>
<!--
    The first-run window (macOS PermissionsOnboarding.swift, OnboardingView): three steps, "Step N of 3". Before you
    record (the consent notice), Microphone (access, a live level meter, Windows' microphone settings) and System audio
    (a short tone measured through endpoint loopback). Back, Continue and Done under the step's card.
-->
<Window
    x:Class="EchoDiar.App.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    Title="Welcome to EchoDiar">

    <!-- The theme's solid background where no system backdrop is set; cleared in code under Mica or Acrylic. -->
    <Grid
        x:Name="RootGrid"
        Padding="24,12,24,20"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        RowSpacing="12">
        <Grid.Resources>
            <Style x:Key="StepIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <Style x:Key="MeterTrackStyle" TargetType="Border">
                <Setter Property="Height" Value="8" />
                <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="MeterFillStyle" TargetType="Border">
                <Setter Property="Width" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" Spacing="4">
            <Image
                Width="48"
                Height="48"
                AutomationProperties.AccessibilityView="Raw"
                Source="ms-appx:///Assets/Square44x44Logo.png" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="EchoDiar" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StepTitleText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="StepCountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <ScrollViewer Padding="20">
                <Grid>
                    <!-- Step 1: Before you record (macOS ConsentStep). -->
                    <StackPanel x:Name="ConsentPanel" Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE716;" Style="{StaticResource StepIconStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{local:T Text='Recording laws differ from place to place. Many require everyone on the call to agree.'}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D7;" Style="{StaticResource StepIconStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{local:T Text='Tell the people you record. You are responsible for their consent.'}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" Style="{StaticResource StepIconStyle}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{local:T Text='Audio and transcripts stay on this PC.'}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock
                            x:Name="ConsentText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                        <Button x:Name="CopyConsentButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="CopyConsentIcon"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE8C8;" />
                                <TextBlock x:Name="CopyConsentText" Text="{local:T Text='Copy consent message'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Step 2: Microphone (macOS MicrophoneStep), with a live level meter. -->
                    <StackPanel
                        x:Name="MicrophonePanel"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock Text="{local:T Text='EchoDiar records your voice on its own channel, so the transcript knows what you said.'}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                x:Name="MicOnIcon"
                                Margin="0"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xEC61;"
                                Style="{StaticResource StepIconStyle}"
                                VerticalAlignment="Center" />
                            <FontIcon
                                x:Name="MicOffIcon"
                                Margin="0"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xEB90;"
                                Style="{StaticResource StepIconStyle}"
                                VerticalAlignment="Center" />
                            <FontIcon
                                x:Name="MicUnknownIcon"
                                Margin="0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE9CE;"
                                Style="{StaticResource StepIconStyle}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="MicStatusText"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            x:Name="MicTrack"
                            AutomationProperties.Name="{local:T Text='Microphone level'}"
                            Style="{StaticResource MeterTrackStyle}">
                            <Border x:Name="MicFill" Style="{StaticResource MeterFillStyle}" />
                        </Border>
                        <TextBlock
                            x:Name="MicDeniedText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button x:Name="OpenMicSettingsButton" Content="{local:T Text='Open Windows microphone settings'}" />
                        <Button x:Name="AllowMicButton" Content="{local:T Text='Allow Microphone'}" />
                    </StackPanel>

                    <!-- Step 3: System audio (macOS SystemAudioStep). -->
                    <StackPanel
                        x:Name="SystemAudioPanel"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock x:Name="SystemAudioText" TextWrapping="Wrap" />
                        <Button x:Name="TestButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE767;" />
                                <TextBlock Text="{local:T Text='Test System Audio'}" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="ListeningPanel" Spacing="8">
                            <Border
                                x:Name="SystemTrack"
                                AutomationProperties.Name="{local:T Text='System audio level'}"
                                Style="{StaticResource MeterTrackStyle}">
                                <Border x:Name="SystemFill" Style="{StaticResource MeterFillStyle}" />
                            </Border>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{local:T Text='Listening…'}" />
                        </StackPanel>
                        <StackPanel x:Name="ResultPanel" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    x:Name="HeardIcon"
                                    Margin="0"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xEC61;"
                                    Style="{StaticResource StepIconStyle}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    x:Name="SilentIcon"
                                    Margin="0"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE74F;"
                                    Style="{StaticResource StepIconStyle}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    x:Name="FailedIcon"
                                    Margin="0"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;"
                                    Style="{StaticResource StepIconStyle}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ResultText"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ResultDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <Button x:Name="TestAgainButton" Content="{local:T Text='Test Again'}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <Button x:Name="BackButton" Content="{local:T Text='Back'}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="ContinueButton"
                    Content="{local:T Text='Continue'}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="DoneButton"
                    Content="{local:T Text='Done'}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
