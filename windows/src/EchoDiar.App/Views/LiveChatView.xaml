<?xml version="1.0" encoding="utf-8"?>
<!--
    The recording's Chat tab (macOS LiveChatView.swift): the recording's chat (questions plain, answers Markdown with
    their model), then the answer being written (or the last one that failed, with its error), or a note while there
    are none; under it the question row (Enter sends, Shift+Enter starts a new line; Stop while an answer is written),
    or why no question can be asked now. Fluent cards in theme resources (Light and Dark), dropped when the view is not
    Framed (side by side); the messages are built in code.
-->
<UserControl
    x:Class="EchoDiar.App.Views.LiveChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <Style x:Key="PaneStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
        <Style x:Key="EmptyNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20" />
        </Style>
        <!-- The styles of the elements built in code: theme resources, so they follow a theme switch. -->
        <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="UserBubbleStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="MaxLines" Value="4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The messages, or a note while there are none. -->
        <Border x:Name="ChatPane" Style="{StaticResource PaneStyle}">
            <Grid>
                <TextBlock
                    x:Name="EmptyText"
                    Style="{StaticResource EmptyNoteStyle}"
                    Text="{local:T Text='Ask about the meeting so far.'}" />
                <ScrollViewer x:Name="ChatScroller" Visibility="Collapsed">
                    <StackPanel x:Name="MessagesPanel" Padding="14,16" Spacing="20" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- The question row, or why no question can be asked now. -->
        <Border
            x:Name="InputPane"
            Grid.Row="1"
            Padding="14,10"
            Style="{StaticResource PaneStyle}">
            <Grid MinHeight="32">
                <TextBlock
                    x:Name="ReasonText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Grid x:Name="QuestionRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="QuestionBox"
                        MaxHeight="152"
                        AcceptsReturn="True"
                        AutomationProperties.Name="{local:T Text='Ask about this conversation'}"
                        PlaceholderText="{local:T Text='Ask about this conversation'}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{local:T Text='Send'}"
                        IsEnabled="False" />
                    <Button
                        x:Name="StopButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Stop'}"
                        ToolTipService.ToolTip="{local:T Text='Stop the answer'}"
                        Visibility="Collapsed">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE71A;" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
