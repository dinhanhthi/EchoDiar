<?xml version="1.0" encoding="utf-8"?>
<!--
    The title bar's toolbar (macOS MainView.swift toolbar). Leading: Back, the record group, the conversation's title.
    Trailing: Update, Reveal and Delete, Settings and Ask across conversations, Search, the conversation's tabs. The
    title and the empty space drag the window (MainWindow makes only the groups, the lone buttons and the search box
    passthrough). Phase 12.2 restyles it.
-->
<UserControl
    x:Class="EchoDiar.App.Views.TitleBarToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <!--
        The title and Search share the free space; Search shrinks from 160 to 90. The last column stays empty: a drag
        strip before the caption buttons on every route. Margins space the columns, since a collapsed group's column
        would keep a ColumnSpacing.
    -->
    <Grid Padding="12,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="90" MaxWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button
                x:Name="BackButton"
                Width="32"
                Height="32"
                Padding="0"
                Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.Name="{local:T Text='Back'}"
                ToolTipService.ToolTip="{local:T Text='Back'}"
                Visibility="Collapsed">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <!-- Idle: Record and its menu of targets and the language. Recording: Stop and Pause or Resume. -->
            <Border x:Name="RecordGroup" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <SplitButton
                        x:Name="RecordSplitButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        AutomationProperties.Name="{local:T Text='Record'}"
                        ToolTipService.ToolTip="{local:T Text='Record'}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE7C8;" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="TargetMenu" Placement="BottomEdgeAlignedLeft" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button
                        x:Name="StopButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Stop recording'}"
                        ToolTipService.ToolTip="{local:T Text='Stop recording'}"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="StopIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE71A;" />
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed">
                        <FontIcon
                            x:Name="PauseIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE769;" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The shown conversation's title and details; not passthrough, so it drags the window like on macOS. -->
        <StackPanel
            x:Name="TitlePanel"
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="DetailText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel
            Grid.Column="2"
            Margin="12,0,8,0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <!-- Phase 27 shows it while an update is available. -->
            <Button
                x:Name="UpdateButton"
                Width="32"
                Height="32"
                Padding="0"
                Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.Name="{local:T Text='Update'}"
                ToolTipService.ToolTip="{local:T Text='Install the available update'}"
                Visibility="Collapsed">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE896;" />
            </Button>

            <Border x:Name="FileGroup" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="RevealButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="Reveal in Explorer"
                        ToolTipService.ToolTip="Reveal in Explorer">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8B7;" />
                    </Button>
                    <Button
                        x:Name="DeleteButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Delete'}"
                        ToolTipService.ToolTip="{local:T Text='Delete the audio or the whole conversation'}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE74D;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="DeleteMenu" Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="DeleteAudioItem" />
                                <MenuFlyoutItem x:Name="DeleteConversationItem" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Settings comes with Phase 13, Ask across conversations with Phase 26. -->
            <Border x:Name="AppGroup" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Settings'}"
                        IsEnabled="False"
                        ToolTipService.ToolTip="{local:T Text='Settings'}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE9E9;" />
                    </Button>
                    <Button
                        x:Name="AskButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Ask across conversations'}"
                        ToolTipService.ToolTip="{local:T Text='Ask across conversations'}"
                        Visibility="Collapsed">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8BD;" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Filters the library and the sidebar as typed; Esc clears it. -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Column="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            AutomationProperties.Name="{local:T Text='Search conversations'}"
            PlaceholderText="{local:T Text='Search'}"
            QueryIcon="Find" />

        <!-- Only Transcript for now: Phase 12 adds the tab pages, Phase 23 Summary and Chat. -->
        <Border
            x:Name="TabsGroup"
            Grid.Column="4"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="TranscriptTab"
                    Style="{StaticResource SubtleButtonStyle}"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Content="{local:T Text='Transcript'}" />
                <Button
                    x:Name="SummaryTab"
                    Style="{StaticResource SubtleButtonStyle}"
                    Content="{local:T Text='Summary'}"
                    IsEnabled="False" />
                <Button
                    x:Name="ChatTab"
                    Style="{StaticResource SubtleButtonStyle}"
                    Content="{local:T Text='Chat'}"
                    IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
