<?xml version="1.0" encoding="utf-8"?>
<!--
    The title bar's toolbar (macOS MainView.swift toolbar) in Windows 11 title bar controls. Leading: Back, the record
    group, a Settings section's inner tabs, the conversation's title. Trailing: Update, Reveal and Delete, Settings, Calendar and Ask across conversations, Search,
    the conversation's tabs. The title and the empty space drag the window (MainWindow makes only the groups, the lone
    buttons, the search box and the tabs passthrough). Icon buttons are 32 x 32 subtle buttons with 16 px Segoe Fluent
    Icons; 4 px between the buttons of a group, 8 px between groups.
-->
<UserControl
    x:Class="EchoDiar.App.Views.TitleBarToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <!--
        The title and Search share the free space 1:1; Search shrinks from 280 to 120, where its placeholder still
        fits. Where even 120 does not fit, Search becomes an icon button that opens the box (code-behind). Search, or
        the conversation's tabs, ends at the caption buttons. Margins space the columns, since a collapsed group's
        column would keep a ColumnSpacing.
    -->
    <Grid x:Name="ToolbarGrid" Padding="12,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeadingColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="TrailingColumn" Width="Auto" />
            <ColumnDefinition x:Name="SearchColumn" Width="*" MinWidth="120" MaxWidth="280" />
            <ColumnDefinition x:Name="TabsColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            Stretch, not Center: the group keeps the title bar's height whether the Settings tabs (about 40 px, the
            buttons 32) show or not, so its buttons stay put when they do.
        -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="BackButton"
                Width="32"
                Height="32"
                Padding="0"
                Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.Name="{local:T Text='Back'}"
                ToolTipService.ToolTip="{local:T Text='Back'}"
                Visibility="Collapsed">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE72B;" />
            </Button>

            <!--
                Idle: Record and its menu of targets and the language, a split button with no fill at rest and the
                default hover, pressed and menu-open fills. Recording: Stop and Pause or Resume.
            -->
            <StackPanel x:Name="RecordGroup" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <SplitButton
                    x:Name="RecordSplitButton"
                    Height="32"
                    Padding="8,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    AutomationProperties.Name="{local:T Text='Record'}"
                    ToolTipService.ToolTip="{local:T Text='Record'}">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE7C8;" />
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="TargetMenu" Placement="BottomEdgeAlignedLeft" />
                    </SplitButton.Flyout>
                </SplitButton>
                <Button
                    x:Name="StopButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{local:T Text='Stop recording'}"
                    ToolTipService.ToolTip="{local:T Text='Stop recording'}"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="StopIcon"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE71A;" />
                </Button>
                <Button
                    x:Name="PauseButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="PauseIcon"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Glyph="&#xE769;" />
                </Button>
            </StackPanel>

            <!--
                The shown Settings section's inner tabs (macOS settingsTabsItem), built per section; collapsed for a
                section without tabs and while the search lists results.
            -->
            <SelectorBar
                x:Name="SettingsTabsBar"
                Padding="0"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </StackPanel>

        <!-- The shown conversation's title and details; not passthrough, so it drags the window like on macOS. -->
        <StackPanel
            x:Name="TitlePanel"
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="DetailText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <StackPanel
            x:Name="TrailingPanel"
            Grid.Column="2"
            Margin="12,0,8,0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <!--
                Shown while an update is available and nothing runs that installing would cut off; while it installs,
                a ring shows how far (code-behind).
            -->
            <Button
                x:Name="UpdateButton"
                Width="32"
                Height="32"
                Padding="0"
                Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.Name="{local:T Text='Update'}"
                ToolTipService.ToolTip="{local:T Text='Install the available update'}"
                Visibility="Collapsed">
                <Grid>
                    <FontIcon
                        x:Name="UpdateIcon"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE896;" />
                    <ProgressRing
                        x:Name="UpdateProgress"
                        Width="16"
                        Height="16"
                        IsIndeterminate="False"
                        Maximum="100"
                        Visibility="Collapsed" />
                </Grid>
            </Button>

            <StackPanel
                x:Name="FileGroup"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Button
                    x:Name="RevealButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{local:T Text='Reveal in Explorer'}"
                    ToolTipService.ToolTip="{local:T Text='Reveal in Explorer'}">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE8B7;" />
                </Button>
                <Button
                    x:Name="DeleteButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{local:T Text='Delete'}"
                    ToolTipService.ToolTip="{local:T Text='Delete the audio or the whole conversation'}">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE74D;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="DeleteMenu" Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="DeleteAudioItem" />
                            <MenuFlyoutItem x:Name="DeleteConversationItem" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!--
                Settings opens the Settings page, or goes back from it, and Calendar the Calendar page; Ask across
                conversations opens or closes the library chat.
            -->
            <StackPanel x:Name="AppGroup" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button
                    x:Name="SettingsButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{local:T Text='Settings'}"
                    ToolTipService.ToolTip="{local:T Text='Settings'}">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE9E9;" />
                </Button>
                <Button
                    x:Name="CalendarButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{local:T Text='Calendar'}"
                    ToolTipService.ToolTip="{local:T Text='Calendar'}">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE787;" />
                </Button>
                <Button
                    x:Name="AskButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.Name="{local:T Text='Ask across conversations'}"
                    ToolTipService.ToolTip="{local:T Text='Ask across conversations'}">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE8BD;" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Filters the library and the sidebar as typed, or on Settings the settings; Esc clears it. -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Column="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            AutomationProperties.Name="{local:T Text='Search conversations'}"
            PlaceholderText="{local:T Text='Search'}"
            QueryIcon="Find" />

        <!-- Where the box does not fit: opens it in place of the trailing buttons until it is left empty. -->
        <Button
            x:Name="SearchButton"
            Grid.Column="3"
            Width="32"
            Height="32"
            Padding="0"
            Style="{StaticResource SubtleButtonStyle}"
            AutomationProperties.Name="{local:T Text='Search conversations'}"
            ToolTipService.ToolTip="{local:T Text='Search'}"
            Visibility="Collapsed">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE721;" />
        </Button>

        <!-- The conversation page's tab (AppViewModel.DetailTab): Transcript, or Summary and Chat (the AI panel). -->
        <SelectorBar
            x:Name="TabsBar"
            Grid.Column="4"
            Margin="8,0,0,0"
            Padding="0"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <SelectorBarItem x:Name="TranscriptTab" Text="{local:T Text='Transcript'}" />
            <SelectorBarItem x:Name="SummaryTab" Text="{local:T Text='Summary'}" />
            <SelectorBarItem x:Name="ChatTab" Text="{local:T Text='Chat'}" />
        </SelectorBar>
    </Grid>
</UserControl>
