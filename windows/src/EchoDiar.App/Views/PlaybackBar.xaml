<?xml version="1.0" encoding="utf-8"?>
<!--
    The transcript's playback (macOS TranscriptView.swift PlaybackScrubber and transport): Play or Pause, the play head
    on a track (a click or a drag moves it, seeking when released), the play head and length, and how the channels
    play (Settings "Playback": both voices in both ears, or my voice left and the others right).
-->
<UserControl
    x:Class="EchoDiar.App.Views.PlaybackBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="PlayButton"
            Width="32"
            Height="32"
            Padding="0"
            VerticalAlignment="Center"
            Style="{StaticResource SubtleButtonStyle}"
            AutomationProperties.Name="{local:T Text='Play'}"
            IsEnabled="False"
            ToolTipService.ToolTip="{local:T Text='Play'}">
            <FontIcon
                x:Name="PlayIcon"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="16"
                Glyph="&#xE768;" />
        </Button>

        <Slider
            x:Name="Scrubber"
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.Name="{local:T Text='Playback position'}"
            IsEnabled="False"
            IsThumbToolTipEnabled="False"
            LargeChange="30"
            Maximum="1"
            Minimum="0"
            SmallChange="5"
            StepFrequency="0.1" />

        <TextBlock
            x:Name="TimeText"
            Grid.Column="2"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="NoWrap" />

        <ToggleButton
            x:Name="ChannelsToggle"
            Grid.Column="3"
            Width="32"
            Height="32"
            Padding="0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{local:T Text='My voice left, others right'}"
            ToolTipService.ToolTip="{local:T Text='My voice left, others right'}">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE7F6;" />
        </ToggleButton>
    </Grid>
</UserControl>
