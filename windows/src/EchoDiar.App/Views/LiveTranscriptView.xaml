<?xml version="1.0" encoding="utf-8"?>
<!--
    Live captions on the recording page, under its header (macOS LiveTranscriptView.swift, setting "Transcribe while
    recording"): the transcriber's state, then the newest lines and the open chunks' greyed tentative text as one
    selectable text, scrolled to the bottom as they arrive unless the user scrolled up, filling the page, then a note
    when the transcript is display only. The lines are built in code.
-->
<UserControl
    x:Class="EchoDiar.App.Views.LiveTranscriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
            The transcript's colors (TranscriptView SpeakerMe and Speaker0): me in the accent color, the others in caution;
            the tentative text in the secondary color. Runs take no style: the code reads these from the swatches below.
        -->
        <Style x:Key="LiveSpeakerMe" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="LiveSpeakerOthers" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="LiveTentativeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- The state: secondary text, or caution when the transcriber stopped. -->
        <Style x:Key="LiveStatusText" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="LiveStatusErrorText" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="LiveStatusIcon" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="LiveStatusErrorIcon" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        Padding="16,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <!-- The rows below the state space themselves by their top margins: a collapsed one takes no room. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Why the transcriber stopped shows as the state's tooltip (cloud realtime's state already says it). -->
            <Grid x:Name="StatusPanel" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    x:Name="StatusIcon"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Glyph="&#xE7F0;"
                    Style="{StaticResource LiveStatusIcon}" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource LiveStatusText}"
                    TextWrapping="Wrap" />
            </Grid>

            <ScrollViewer
                x:Name="Scroller"
                Grid.Row="1"
                Margin="0,8,0,0"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <!--
                    One paragraph per line ("Name: text"), then the tentative ones: a drag selects across lines and Ctrl+C
                    copies plain text. Right padding keeps the text clear of the scroll bar.
                -->
                <RichTextBlock
                    x:Name="CaptionText"
                    Padding="0,0,16,0"
                    IsTextSelectionEnabled="True"
                    SelectionFlyout="{x:Null}"
                    TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- A display-only transcript (DisplayOnly): the saved one is made after Stop. -->
            <TextBlock
                x:Name="DisplayOnlyText"
                Grid.Row="2"
                Margin="0,8,0,0"
                Style="{StaticResource LiveStatusText}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- The brushes of the styles above, in the current theme, for the text's runs. -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="MeSwatch" Style="{StaticResource LiveSpeakerMe}" />
                <TextBlock x:Name="OthersSwatch" Style="{StaticResource LiveSpeakerOthers}" />
                <TextBlock x:Name="TentativeSwatch" Style="{StaticResource LiveTentativeText}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
