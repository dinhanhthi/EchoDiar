<?xml version="1.0" encoding="utf-8"?>
<!--
    One conversation of the library (macOS ConversationCard.swift): the source icon, the title (double-click to rename),
    the source app's name, the date, duration, size, status pill and "Audio has been removed" marker, the reason of a
    failed transcription, then a row with Reveal in Explorer, the Delete menu and the transcription progress or its
    action. A Fluent card (card fill and stroke, overlay corners, 16 px padding) in theme resources (Light and Dark).
    Compact (the wide layout's sidebar) drops the buttons, which stay in the context menu. Selected adds the accent
    fill and edge. The AI and Summary buttons come with Phase 23.
-->
<UserControl
    x:Class="EchoDiar.App.Views.ConversationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <Grid Margin="0,5">
        <Grid.ContextFlyout>
            <MenuFlyout x:Name="CardMenu">
                <MenuFlyoutItem x:Name="RenameItem" Text="{local:T Text='Rename'}" />
                <MenuFlyoutItem x:Name="RevealItem" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuDeleteAudioItem" />
                <MenuFlyoutItem x:Name="MenuDeleteConversationItem" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}" />
        <Border
            x:Name="SelectionFill"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Opacity="0.12"
            Visibility="Collapsed" />

        <Grid x:Name="ContentGrid" Padding="16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Windows keeps only the exe name of the source app: a generic audio glyph, as macOS shows for global recordings. -->
            <Grid
                Width="32"
                Height="32"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8D6;" />
            </Grid>

            <StackPanel Grid.Column="1" Spacing="4">
                <Grid>
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBox
                        x:Name="TitleBox"
                        Padding="4,2"
                        MinHeight="0"
                        AutomationProperties.Name="{local:T Text='Title'}"
                        PlaceholderText="{local:T Text='Title'}"
                        Visibility="Collapsed" />
                </Grid>

                <StackPanel x:Name="DetailsRow" Orientation="Horizontal" Spacing="8">
                    <!-- The source app (macOS shows its icon; Windows keeps only its name and exe). -->
                    <TextBlock
                        x:Name="SourceAppText"
                        MaxWidth="160"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        TextWrapping="NoWrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="DateText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="DurationText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="SizeText"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- The statuses that need attention: one pill per severity, in the theme's status colors. -->
                    <Border
                        x:Name="CriticalBadge"
                        Padding="8,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="9"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="CriticalBadgeText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Border>
                    <Border
                        x:Name="CautionBadge"
                        Padding="8,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="9"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="CautionBadgeText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Border>
                    <Border
                        x:Name="AttentionBadge"
                        Padding="8,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="9"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="AttentionBadgeText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                    </Border>
                    <FontIcon
                        x:Name="NoAudioIcon"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE74F;"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Why the last transcription failed, up to two lines (the full text on hover). -->
                <TextBlock
                    x:Name="FailureText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <!-- Reveal and Delete (not compact), then the transcription progress or its action. -->
                <StackPanel
                    x:Name="ActionRow"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="12">
                    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="RevealButton">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8B7;" />
                        </Button>
                        <DropDownButton
                            x:Name="DeleteButton"
                            AutomationProperties.Name="{local:T Text='Delete'}"
                            ToolTipService.ToolTip="{local:T Text='Delete the audio or the whole conversation'}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE74D;" />
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="DeleteMenu" Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem x:Name="DeleteAudioItem" />
                                    <MenuFlyoutItem x:Name="DeleteConversationItem" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <!-- A job's ring (or a spinner while queued or waiting), its step; the percent on hover. -->
                    <StackPanel
                        x:Name="ProgressPanel"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                        <ProgressRing
                            x:Name="JobRing"
                            Width="12"
                            Height="12"
                            MinWidth="0"
                            MinHeight="0"
                            Maximum="1" />
                        <TextBlock
                            x:Name="StepText"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- A job waiting while energy saver is on starts now. -->
                    <Button
                        x:Name="TranscribeNowButton"
                        VerticalAlignment="Center"
                        Content="{local:T Text='Transcribe now'}"
                        ToolTipService.ToolTip="{local:T Text='Transcribe now, even with energy saver on'}"
                        Visibility="Collapsed" />

                    <!-- macOS opens Settings > Transcription; Settings comes with a later phase. -->
                    <Border
                        x:Name="NeedsModelBadge"
                        Padding="8,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="9"
                        ToolTipService.ToolTip="{local:T Text='Download a transcription model in Settings'}"
                        Visibility="Collapsed">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="{local:T Text='Needs model'}" />
                    </Border>

                    <!-- Retry, and its menu of the other engines ("Retry with another engine"). -->
                    <SplitButton
                        x:Name="RetryButton"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{local:T Text='Retry'}" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="EngineMenu" Placement="BottomEdgeAlignedLeft" />
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button
                        x:Name="TranscribeButton"
                        VerticalAlignment="Center"
                        Content="{local:T Text='Transcribe'}"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border
            x:Name="SelectionStroke"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
