<?xml version="1.0" encoding="utf-8"?>
<!--
    The event editor of EchoDiar's own calendar (macOS EventEditorSheet.swift): Title, Date, Start, End, Meeting link,
    Repeat, End Repeat and End date, with the macOS hints, the store's error, and Delete Event… for an existing event.
    The question about a repeating event (This Event Only / This and Future Events / Cancel) is shown in this same dialog,
    as WinUI opens one ContentDialog at a time; the buttons and texts are set in code.
-->
<ContentDialog
    x:Class="EchoDiar.App.Views.EventEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel x:Name="Body" Width="420" Spacing="12">
        <!-- The form, disabled until the event is read. -->
        <ContentControl x:Name="Form" HorizontalContentAlignment="Stretch" IsTabStop="False">
            <StackPanel Spacing="12">
                <TextBox x:Name="TitleBox" Header="{local:T Text='Title'}" />
                <CalendarDatePicker x:Name="DayPicker" HorizontalAlignment="Stretch" Header="{local:T Text='Date'}" />
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TimePicker
                            x:Name="StartPicker"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Header="{local:T Text='Start'}" />
                        <TimePicker
                            x:Name="EndPicker"
                            Grid.Column="1"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Header="{local:T Text='End'}" />
                    </Grid>
                    <TextBlock x:Name="EndHint" Style="{StaticResource HintStyle}" Text="{local:T Text='The end must be after the start.'}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBox
                        x:Name="LinkBox"
                        Header="{local:T Text='Meeting link'}"
                        InputScope="Url"
                        PlaceholderText="https://…" />
                    <TextBlock x:Name="LinkHint" Style="{StaticResource HintStyle}" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="RepeatBox" HorizontalAlignment="Stretch" Header="{local:T Text='Repeat'}" />
                    <ComboBox
                        x:Name="EndRepeatBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="{local:T Text='End Repeat'}" />
                </Grid>
                <StackPanel Spacing="4">
                    <CalendarDatePicker x:Name="RepeatEndPicker" HorizontalAlignment="Stretch" Header="{local:T Text='End date'}" />
                    <TextBlock x:Name="RepeatEndHint" Style="{StaticResource HintStyle}" Text="{local:T Text='The repeat ends before this date.'}" />
                </StackPanel>
            </StackPanel>
        </ContentControl>

        <!-- The event is gone or not in EchoDiar's calendar. -->
        <TextBlock
            x:Name="LoadFailedText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- The store's error: the dialog stays open. -->
        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <Button x:Name="DeleteButton" Content="{local:T Text='Delete Event…'}" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
