<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EchoDiar.App.Views.ConversationListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <!-- The day headers (macOS DayHeader): muted, semibold caption text, centered. -->
        <Style x:Key="DayHeaderText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header and the banner are left out of the wide layout's sidebar, which shows only the rows. -->
        <Grid x:Name="HeaderGrid">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="Library" />
        </Grid>

        <!-- Shown until a speech model is installed (and a speaker model, with "Tell speakers apart" on). -->
        <StackPanel
            x:Name="ModelBanner"
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock x:Name="BannerTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Download a transcription model" />
            <TextBlock x:Name="BannerDetail" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ModelPicker" MinWidth="320" AutomationProperties.Name="Model" />
                <Button x:Name="DownloadButton" Click="OnDownloadClick" Content="Download" />
                <Button x:Name="CancelButton" Click="OnCancelClick" Content="Cancel" Visibility="Collapsed" />
            </StackPanel>
            <ProgressBar x:Name="DownloadBar" Maximum="1" Visibility="Collapsed" />
            <TextBlock
                x:Name="DownloadErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- While cards are selected (Ctrl-click, Shift-click): their count, Delete and Cancel, above the list. -->
            <Border
                x:Name="SelectionBar"
                Margin="0,0,0,8"
                Padding="14,4"
                Style="{StaticResource SolidCard}"
                CornerRadius="{StaticResource CornerRadiusXLarge}"
                Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SelectionCountText"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="SelectionDeleteButton"
                        Grid.Column="1"
                        Style="{StaticResource CapsuleButton}"
                        AutomationProperties.Name="{local:T Text='Delete'}"
                        ToolTipService.ToolTip="{local:T Text='Delete the audio or the selected conversations'}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE74D;" />
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="8" Glyph="&#xE70D;" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="SelectionDeleteMenu" Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="SelectionDeleteAudioItem" />
                                <MenuFlyoutItem x:Name="SelectionDeleteConversationsItem" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="SelectionCancelButton"
                        Grid.Column="2"
                        Style="{StaticResource CapsuleButton}"
                        AutomationProperties.Name="{local:T Text='Cancel'}"
                        ToolTipService.ToolTip="{local:T Text='Cancel the selection (Esc)'}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>

            <!--
                Day headers and conversation cards (ListViewItems made in code), newest first; the header is the
                recording's card while recording. No ListView selection: the cards draw the open conversation and the
                Ctrl/Shift selection themselves, so the arrow keys only move the focus.
            -->
            <ListView
                x:Name="ConversationList"
                Grid.Row="1"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                </ListView.Resources>
            </ListView>

            <!-- Why there are no cards: an empty library, or a search without results. -->
            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                Margin="20,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
