<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EchoDiar.App.Views.ConversationListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <!-- The section headers (macOS DayHeader): muted, semibold caption text, left-aligned with the cards. -->
        <Style x:Key="DayHeaderText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Filters the cards as typed (macOS sidebarSearchField), above the cards and the empty states; Ctrl+F focuses
            it, Esc clears it.
        -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Margin="0,0,0,12"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="{local:T Text='Search conversations'}"
            PlaceholderText="{local:T Text='Search conversations'}"
            QueryIcon="Find" />

        <!--
            Shown until a speech model is installed (and a speaker model, with "Tell speakers apart" on), at the top of
            the 360 px sidebar: the model on its own row (long names end in an ellipsis), then Download or Cancel.
            Collapsed while closed, so its margin goes too.
        -->
        <InfoBar
            x:Name="ModelBanner"
            Grid.Row="1"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            Visibility="Collapsed">
            <StackPanel Margin="0,0,16,16" Spacing="8">
                <ComboBox
                    x:Name="ModelPicker"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{local:T Text='Model'}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock
                                MaxLines="1"
                                Text="{x:Bind}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DownloadButton" Click="OnDownloadClick" Content="{local:T Text='Download'}" />
                    <Button
                        x:Name="CancelButton"
                        Click="OnCancelClick"
                        Content="{local:T Text='Cancel'}"
                        Visibility="Collapsed" />
                </StackPanel>
                <ProgressBar x:Name="DownloadBar" Maximum="1" Visibility="Collapsed" />
                <TextBlock
                    x:Name="DownloadErrorText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </InfoBar>

        <!-- The cards on a card panel like the detail's (macOS libraryWell); the cards a subtle fill above it. -->
        <Border
            Grid.Row="2"
            Padding="0,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Section headers and the current page's conversation cards (ListViewItems made in code), newest
                    first; the header is the recording's card while recording, on every page and with a search. No ListView selection: the cards draw the open conversation and the
                    Ctrl/Shift selection themselves. The window's ↑/↓ open the previous or next card (and focus it) before the
                    ListView sees them.
                -->
                <ListView
                    x:Name="ConversationList"
                    Grid.Row="1"
                    IsItemClickEnabled="False"
                    SelectionMode="None" />

                <!-- Why there are no cards: an empty library, or a search without results. -->
                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="1"
                    Margin="20,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    TextAlignment="Center"
                    Visibility="Collapsed" />

                <!--
                    While cards are selected (Ctrl-click, Shift-click): their count, Delete and Cancel, as a command bar above
                    the list, which moves down to make room (macOS SelectionBar).
                -->
                <Border
                    x:Name="SelectionBar"
                    Margin="16,0,12,8"
                    Padding="12,4,4,4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SelectionCountText"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Button
                            x:Name="SelectionDeleteButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="{local:T Text='Delete'}"
                            ToolTipService.ToolTip="{local:T Text='Delete the audio or the selected conversations'}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE74D;" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="SelectionDeleteMenu" Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="SelectionDeleteAudioItem" />
                                    <MenuFlyoutItem x:Name="SelectionDeleteConversationsItem" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="SelectionCancelButton"
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="{local:T Text='Cancel'}"
                            ToolTipService.ToolTip="{local:T Text='Cancel the selection (Esc)'}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </Border>

                <!--
                    "‹ 1–100 of 742 ›" under the cards while there is more than one page (macOS pageBar); the arrows are
                    disabled at the first and the last page.
                -->
                <Border
                    x:Name="PageBar"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="0,8,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="PreviousPageButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="{local:T Text='Previous page'}"
                            ToolTipService.ToolTip="{local:T Text='Previous page'}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE76B;" />
                        </Button>
                        <TextBlock
                            x:Name="PageText"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextWrapping="NoWrap" />
                        <Button
                            x:Name="NextPageButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="{local:T Text='Next page'}"
                            ToolTipService.ToolTip="{local:T Text='Next page'}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
