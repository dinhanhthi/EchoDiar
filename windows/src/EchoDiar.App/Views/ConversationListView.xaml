<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EchoDiar.App.Views.ConversationListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <!-- The day headers (macOS DayHeader): muted, semibold caption text, left-aligned with the cards. -->
        <Style x:Key="DayHeaderText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header and the banner are left out of the wide layout's sidebar, which shows only the rows. -->
        <Grid x:Name="HeaderGrid">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="Library" />
        </Grid>

        <!-- Shown until a speech model is installed (and a speaker model, with "Tell speakers apart" on). -->
        <InfoBar
            x:Name="ModelBanner"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False"
            Severity="Informational"
            Title="Download a transcription model">
            <StackPanel Margin="0,0,16,16" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ModelPicker" MinWidth="320" AutomationProperties.Name="Model" />
                    <Button x:Name="DownloadButton" Click="OnDownloadClick" Content="Download" />
                    <Button x:Name="CancelButton" Click="OnCancelClick" Content="Cancel" Visibility="Collapsed" />
                </StackPanel>
                <ProgressBar x:Name="DownloadBar" Maximum="1" Visibility="Collapsed" />
                <TextBlock
                    x:Name="DownloadErrorText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </InfoBar>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Day headers and conversation cards (ListViewItems made in code), newest first; the header is the
                recording's card while recording. No ListView selection: the cards draw the open conversation and the
                Ctrl/Shift selection themselves, so the arrow keys only move the focus.
            -->
            <ListView
                x:Name="ConversationList"
                Grid.Row="1"
                IsItemClickEnabled="False"
                SelectionMode="None" />

            <!-- Why there are no cards: an empty library, or a search without results. -->
            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                Margin="20,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                TextAlignment="Center"
                Visibility="Collapsed" />

            <!--
                While cards are selected (Ctrl-click, Shift-click): their count, Delete and Cancel, as a command bar above
                the list, which moves down to make room (macOS SelectionBar).
            -->
            <Border
                x:Name="SelectionBar"
                Margin="0,0,0,8"
                Padding="12,4,4,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Visibility="Collapsed">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SelectionCountText"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Button
                        x:Name="SelectionDeleteButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Delete'}"
                        ToolTipService.ToolTip="{local:T Text='Delete the audio or the selected conversations'}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE74D;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SelectionDeleteMenu" Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="SelectionDeleteAudioItem" />
                                <MenuFlyoutItem x:Name="SelectionDeleteConversationsItem" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="SelectionCancelButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.Name="{local:T Text='Cancel'}"
                        ToolTipService.ToolTip="{local:T Text='Cancel the selection (Esc)'}">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
