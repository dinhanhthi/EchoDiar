<?xml version="1.0" encoding="utf-8"?>
<!--
    The Calendar page of the main window (macOS CalendarView.swift): calendar access while it is missing, then the
    upcoming meetings of the next 7 days by day, each in a card with Edit… (EchoDiar's own events), Join (with a meeting
    link), Record and a Skip switch. One scrolling column of Fluent cards in theme resources (Light and Dark); the day
    headers and the event cards are built in code. Event titles come from invites: shown as plain text only.
-->
<UserControl
    x:Class="EchoDiar.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- The styles of the elements built in code: theme resources, so they follow a theme switch. -->
        <Style x:Key="DayHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="12" Spacing="12">
            <!-- Header: the title, New Event… and Calendar settings…, then what the list shows. -->
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{local:T Text='Calendar'}" />
                    <Button x:Name="NewEventButton" Grid.Column="1" Content="{local:T Text='New Event…'}" />
                    <Button x:Name="CalendarSettingsButton" Grid.Column="2" Content="{local:T Text='Calendar settings…'}" />
                </Grid>
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{local:T Text='Showing meetings in the next 7 days. The list updates automatically.'}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- No access: what is missing and how to grant it. -->
            <Border x:Name="AccessCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{local:T Text='Upcoming meetings show here once EchoDiar can read your calendars.'}"
                        TextWrapping="Wrap" />
                    <TextBlock x:Name="AccessText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="GrantAccessButton" Content="{local:T Text='Grant Access'}" />
                    <Button x:Name="PrivacySettingsButton" Content="{local:T Text='Open Windows privacy settings'}" />
                </StackPanel>
            </Border>

            <!-- Launch at login is off: meetings only trigger while EchoDiar runs. -->
            <Border x:Name="LaunchAtLoginCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{local:T Text='EchoDiar reacts to meetings only while it runs. Turn on Launch at login in General.'}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="OpenGeneralButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{local:T Text='Open General'}" />
                </Grid>
            </Border>

            <!-- No event to show. -->
            <Border x:Name="EmptyCard" Padding="20" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{local:T Text='No upcoming meetings in the next 7 days.'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="LinkOnlyText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        Text="{local:T Text='Only events with a meeting link, or in the EchoDiar calendar, are shown.'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- The day headers and the event cards (CalendarPage.Build). -->
            <StackPanel x:Name="EventsPanel" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
