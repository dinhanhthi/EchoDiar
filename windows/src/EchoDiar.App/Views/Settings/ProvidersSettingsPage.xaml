<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings › AI Providers (macOS ProvidersSettingsView.swift), one panel per inner tab picked in the title bar:
    - Local AI: five groups, one shown at a time, picked in the tabs pinned above the page (macOS LocalAIGroup and its
      CapsuleTabs):
      - Language models: the models that run on this PC (Windows AI's state, hidden when this PC can never run it; the
        GGUF models with Download, progress and Cancel, Installed and Delete). The models used for chat, summaries and
        catch-up are picked in AI Settings.
      - Transcription, Diarization: the local speech and speaker models by tier (LocalModelRows).
      - Embedding: the catalog's embedding models' downloads (the one in use is picked in AI Settings › Library chat).
      - Local hosts: a scan finds them, Foundry Local included; a host is added, or typed by URL.
    - Cloud: the cloud provider cards (ProviderCardList): keys, base URLs and default models.
    - CLIs: the subscription CLIs found on this PC.
    The local host and CLI rows are made in code (ProvidersSettingsPage.*Row): an expander with the Enabled switch, and
    its fields below in a label column and an input column (FieldGrid, as the cards). Each searchable element's Tag is
    its search entry's title (SearchEntries), so a search result can bring it into view.
-->
<UserControl
    x:Class="EchoDiar.App.Views.ProvidersSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:EchoDiar.App"
    xmlns:views="using:EchoDiar.App.Views">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="1,24,0,4" />
            <Setter Property="Spacing" Value="2" />
        </Style>
        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- What a group's models do, above their sections (as Settings › Transcription). -->
        <Style x:Key="IntroStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,4,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The parts of the rows made in code, in theme colours. -->
        <Style
            x:Key="NoteStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="CautionNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style
            x:Key="CriticalNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style
            x:Key="SuccessNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SuccessIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="CautionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <!-- The one badge that must stand out: Default, in the accent colour. -->
        <Style x:Key="DefaultBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style
            x:Key="DefaultBadgeTextStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="NoticeIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- A transcription model's approximate price on the Cloud cards (macOS CloudPriceBadge): neutral, so only Default stands out. -->
        <Style x:Key="PriceBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Local AI's groups (macOS localAITabs: CapsuleTabs centered and pinned above the form), shown on Local AI only;
            items made in code (LocalAIGroups).
        -->
        <SelectorBar
            x:Name="LocalAIGroupsBar"
            Margin="24,8,24,0"
            HorizontalAlignment="Center"
            Visibility="Collapsed" />

        <ScrollViewer Grid.Row="1">
            <Grid MaxWidth="1000" Margin="24,12,24,24">

                <!-- Local AI: one group shown at a time. -->
                <Grid x:Name="LocalAIPanel">
                    <!-- Language models -->
                    <StackPanel x:Name="LanguageModelsPanel" Spacing="4">
                        <StackPanel
                            Margin="1,4,0,4"
                            Spacing="2"
                            Tag="Language models">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Language models'}" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="{local:T Text='Models that run on this PC, for summaries and chat.'}" />
                        </StackPanel>

                        <!-- Hidden when this PC can never run Windows AI; else why it cannot run now, or Available. -->
                        <controls:SettingsCard
                            x:Name="WindowsAICard"
                            Header="{local:T Text='Windows AI (system)'}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="WindowsAIIcon"
                                    Glyph="&#xE73E;"
                                    Style="{StaticResource SuccessIconStyle}" />
                                <TextBlock
                                    x:Name="WindowsAIText"
                                    MaxWidth="420"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button x:Name="WindowsAICheckButton" Content="{local:T Text='Check Again'}" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <!-- The GGUF models (macOS mlxEntries' ModelRow), made in code. -->
                        <StackPanel x:Name="LocalModelsList" Spacing="4" />
                    </StackPanel>

                    <!-- Transcription: what the models do, then a header per tier and its rows (made in code). -->
                    <StackPanel
                        x:Name="TranscriptionPanel"
                        Spacing="4"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource IntroStyle}"
                            Tag="Transcription models"
                            Text="{local:T Text='Transcription turns speech into text. The transcription model listens to the recording and writes what was said, with timestamps.'}" />
                        <StackPanel x:Name="TranscriptionList" Spacing="4" />
                    </StackPanel>

                    <!-- Diarization -->
                    <StackPanel
                        x:Name="DiarizationPanel"
                        Spacing="4"
                        Visibility="Collapsed">
                        <TextBlock
                            Style="{StaticResource IntroStyle}"
                            Tag="Diarization models"
                            Text="{local:T Text='Diarization finds who spoke when. The diarization model tells the voices apart and labels each part of the transcript with its speaker.'}" />
                        <StackPanel x:Name="DiarizationList" Spacing="4" />
                    </StackPanel>

                    <!-- Embedding: the catalog's embedding models' downloads (macOS embeddingSection), made in code. -->
                    <StackPanel
                        x:Name="EmbeddingPanel"
                        Spacing="4"
                        Visibility="Collapsed">
                        <StackPanel
                            Margin="1,4,0,4"
                            Spacing="2"
                            Tag="Embedding models">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Embedding models'}" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="{local:T Text='The embedding model lets a question find passages with the same meaning, in any language. Models are downloaded only when you click Download.'}" />
                        </StackPanel>
                        <StackPanel x:Name="EmbeddingList" Spacing="4" />
                    </StackPanel>

                    <!-- Local hosts -->
                    <StackPanel
                        x:Name="LocalHostsPanel"
                        Spacing="4"
                        Visibility="Collapsed">
                        <!-- Scan sits on the header's line, at its trailing edge (macOS). -->
                        <Grid
                            Margin="1,4,0,4"
                            ColumnSpacing="8"
                            Tag="Local hosts">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{local:T Text='Local hosts'}" />
                            <ProgressRing
                                x:Name="ScanRing"
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="NoneFoundText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{local:T Text='None found'}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="ScanButton"
                                Grid.Column="2"
                                Content="{local:T Text='Scan'}" />
                        </Grid>

                        <!-- The hosts the scan found, then the saved local hosts (rows made in code). -->
                        <StackPanel x:Name="FoundHostsList" Spacing="4" />
                        <StackPanel x:Name="LocalHostsList" Spacing="4" />

                        <controls:SettingsCard Header="{local:T Text='Custom URL'}">
                            <!-- The box narrows (then Add wraps) in a narrow window instead of being clipped. -->
                            <views:FieldPanel InputWidth="260">
                                <TextBox
                                    x:Name="CustomUrlBox"
                                    AutomationProperties.Name="{local:T Text='Custom URL'}"
                                    PlaceholderText="http://127.0.0.1:8080/v1" />
                                <Button
                                    x:Name="AddCustomButton"
                                    Content="{local:T Text='Add'}"
                                    IsEnabled="False" />
                            </views:FieldPanel>
                        </controls:SettingsCard>
                    </StackPanel>
                </Grid>

                <!-- Cloud -->
                <StackPanel
                    x:Name="CloudPanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <StackPanel
                        Margin="1,4,0,8"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource NoticeIconStyle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{local:T Text='Data sent to cloud providers or CLIs leaves this PC.'}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- The provider cards' group titles, cards and Add Endpoint (macOS ProviderCardSections), made in code. -->
                    <StackPanel x:Name="CloudCardsPanel" Spacing="4" />
                </StackPanel>

                <!-- CLIs -->
                <StackPanel
                    x:Name="CliPanel"
                    Spacing="4"
                    Visibility="Collapsed">
                    <StackPanel
                        Margin="1,4,0,8"
                        Orientation="Horizontal"
                        Spacing="8"
                        Tag="CLIs">
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource NoticeIconStyle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{local:T Text='Data sent to cloud providers or CLIs leaves this PC.'}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="CliList" Spacing="4" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
