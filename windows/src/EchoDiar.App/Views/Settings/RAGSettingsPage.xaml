<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings › RAG (macOS RAGSettingsView.swift): the opt-in switch of the library chat; the index's status with
    Rebuild; then the embedder of the index: the catalog's GGUF embedding models with Download, progress and Cancel,
    Installed and Delete ("On this PC"), or an enabled OpenAI-compatible or local-host provider with its model ("Via
    API"). The embedder rows are made in code (RAGSettingsPage.EmbedderRow, ProviderRow) and updated in place. Each
    searchable element's Tag is its search entry's title (SearchEntries), so a search result can bring it into view.
-->
<UserControl
    x:Class="EchoDiar.App.Views.RAGSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:EchoDiar.App"
    xmlns:views="using:EchoDiar.App.Views">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="1,24,0,4" />
            <Setter Property="Spacing" Value="2" />
        </Style>
        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The parts of the rows made in code, in theme colours. -->
        <Style
            x:Key="NoteStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="CautionNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style
            x:Key="CriticalNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style
            x:Key="SuccessNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SuccessIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="CautionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <!-- The one badge that must stand out: Default, in the accent colour. -->
        <Style x:Key="DefaultBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style
            x:Key="DefaultBadgeTextStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Margin="24,12,24,24"
            Spacing="4">

            <!-- The description names this PC: set in code (Windows text). -->
            <controls:SettingsCard
                x:Name="EnableCard"
                Header="{local:T Text='Ask across conversations'}"
                Tag="Ask across conversations">
                <ToggleSwitch x:Name="EnableToggle" AutomationProperties.Name="{local:T Text='Ask across conversations'}" />
            </controls:SettingsCard>

            <!-- Index -->
            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Index'}" />
            </StackPanel>

            <!-- While RAG is on: how far the index is, why it waits or stopped. -->
            <controls:SettingsCard x:Name="StatusCard">
                <controls:SettingsCard.Description>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="PausedText"
                            Style="{StaticResource NoteStyle}"
                            Text="{local:T Text='Paused while recording or transcribing'}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="MessageText"
                            Style="{StaticResource CriticalNoteStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </controls:SettingsCard.Description>
                <ProgressRing
                    x:Name="StatusRing"
                    Width="16"
                    Height="16"
                    IsActive="False"
                    Visibility="Collapsed" />
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="ConsentCard"
                Header="{local:T Text='Needs confirmation'}"
                Visibility="Collapsed">
                <Button x:Name="ConfirmButton" Content="{local:T Text='Confirm…'}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="{local:T Text='Deletes the index and embeds every conversation again.'}"
                Header="{local:T Text='Rebuild index'}"
                Tag="Rebuild index">
                <Button
                    x:Name="RebuildButton"
                    AutomationProperties.Name="{local:T Text='Rebuild index'}"
                    Content="{local:T Text='Rebuild'}" />
            </controls:SettingsCard>

            <!-- On this PC: the catalog's embedding models (macOS ModelCatalog.embedding's ModelRow), made in code. -->
            <StackPanel Style="{StaticResource SectionHeaderStyle}" Tag="Embedding model">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='On this PC'}" />
                <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="{local:T Text='The embedding model lets a question find passages with the same meaning, in any language. Models are downloaded only when you click Download.'}" />
            </StackPanel>

            <StackPanel x:Name="EmbedderList" Spacing="4" />

            <!-- Via API: the model of the provider in use, then the providers that can embed. -->
            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Via API'}" />
                <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="{local:T Text='A cloud provider receives the transcripts and summaries to index, and each question.'}" />
            </StackPanel>

            <controls:SettingsCard
                x:Name="APIModelCard"
                Header="{local:T Text='Model'}"
                Visibility="Collapsed">
                <controls:SettingsCard.Description>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="LoadErrorText"
                            MaxLines="2"
                            Style="{StaticResource CriticalNoteStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="NoModelsText"
                            Style="{StaticResource NoteStyle}"
                            Text="{local:T Text='No embedding models listed; type the model id.'}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </controls:SettingsCard.Description>
                <views:FieldPanel InputWidth="260">
                    <TextBox x:Name="APIModelBox" AutomationProperties.Name="{local:T Text='Model'}" />
                    <DropDownButton x:Name="ModelsButton" Visibility="Collapsed">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ModelsMenu" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="LoadModelsButton" Content="{local:T Text='Load models'}" />
                    <ProgressRing
                        x:Name="LoadRing"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />
                </views:FieldPanel>
            </controls:SettingsCard>

            <StackPanel x:Name="ProviderList" Spacing="4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
