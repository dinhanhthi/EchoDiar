<?xml version="1.0" encoding="utf-8"?>
<!--
    The Settings page of the main window (macOS SettingsWindow.swift SettingsView): a 200 px sidebar of the sections
    (Services/SettingsSearch.cs) with their icons, the selected section's page on the right. While the toolbar's search
    has a term, the sidebar lists only the sections with a matching row, none selected, and the right side lists the
    matching rows (macOS SettingsSearchResults); a row opens its section and inner tab and clears the search.
    A NavigationView in Left mode, pane always open: it sits below the custom title bar, so it never draws its own. Its
    content area draws no layer of its own: it sits on the window body's layer, like the other pages. The selected
    section is an accent capsule, like macOS.
-->
<UserControl
    x:Class="EchoDiar.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="Nav"
        CompactModeThresholdWidth="0"
        ExpandedModeThresholdWidth="0"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="200"
        PaneDisplayMode="Left">

        <NavigationView.Resources>
            <ResourceDictionary>
                <!--
                    The selected section is an accent capsule (macOS: accent capsule, white icon and title): the item
                    brushes of WinUI's NavigationView theme resources, in the accent, with no left pill bar. The text on
                    the accent follows Fluent (TextOnAccentFillColor*). High contrast keeps WinUI's own values.
                -->
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Opacity="0.9" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Opacity="0.8" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource TextOnAccentFillColorSecondary}" />
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColorDark1}" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Opacity="0.9" Color="{ThemeResource SystemAccentColorDark1}" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Opacity="0.8" Color="{ThemeResource SystemAccentColorDark1}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource TextOnAccentFillColorPrimary}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource TextOnAccentFillColorSecondary}" />
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

                <!--
                    A capsule: half the 36 px item height (NavigationViewItemOnLeftMinHeight). The item hands its
                    CornerRadius to the presenter's root, which draws the selected, hover and pressed fills and the
                    focus rectangle, so they all take this shape. Only the sidebar's items: the pages have none.
                -->
                <Style TargetType="NavigationViewItem">
                    <Setter Property="CornerRadius" Value="18" />
                </Style>
            </ResourceDictionary>
        </NavigationView.Resources>

        <Grid>
            <!-- The selected section's page; each section's page is made the first time it shows, then kept. -->
            <ContentControl
                x:Name="SectionHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False" />

            <!-- Search results: one clickable row per matching setting, "Section › Tab › Row". -->
            <Grid x:Name="ResultsPanel" Visibility="Collapsed">
                <ScrollViewer x:Name="ResultsScroller">
                    <!-- Rows are made in code, each with its own click (SettingsPage.ShowResults). -->
                    <StackPanel x:Name="ResultsList" Margin="24,16,24,24" Spacing="4" />
                </ScrollViewer>

                <TextBlock
                    x:Name="NoResultsText"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </NavigationView>
</UserControl>
