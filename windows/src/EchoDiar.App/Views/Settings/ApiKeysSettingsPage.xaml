<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings › API Keys (macOS APIKeysSettingsView.swift): one card per cloud provider that takes a key, in three
    groups: the LLM presets (Language models), the speech-to-text APIs, then the custom OpenAI-compatible endpoints and
    Add Endpoint. The cards are made in code (ApiKeysSettingsPage.ApiKeyCard): an expander with the provider's name;
    expanded, its key, Save and Test, the base URL for Azure and custom endpoints, and a custom endpoint's name,
    authentication, extra headers and Remove. No model fields and no Enabled switch: a cloud API is available once its
    key is saved; models are picked in the feature tabs. Keys go to Credential Manager only. Each searchable element's
    Tag is its search entry's title (SearchEntries), so a search result can bring it into view.
-->
<UserControl
    x:Class="EchoDiar.App.Views.ApiKeysSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="1,24,0,4" />
            <Setter Property="Spacing" Value="2" />
        </Style>
        <!-- The parts of the cards made in code, in theme colours. -->
        <Style
            x:Key="NoteStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="CautionNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style
            x:Key="CriticalNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style
            x:Key="SuccessNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SuccessIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Margin="24,12,24,24"
            Spacing="4">
            <StackPanel Margin="1,4,0,4" Tag="Language models">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Language models'}" />
            </StackPanel>
            <StackPanel x:Name="LanguageModelsList" Spacing="4" />

            <StackPanel Style="{StaticResource SectionHeaderStyle}" Tag="Speech-to-text APIs">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Speech-to-text APIs'}" />
            </StackPanel>
            <StackPanel x:Name="SpeechToTextList" Spacing="4" />

            <StackPanel Style="{StaticResource SectionHeaderStyle}" Tag="Custom OpenAI-compatible endpoints">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Custom OpenAI-compatible endpoints'}" />
            </StackPanel>
            <StackPanel x:Name="CustomList" Spacing="4" />
            <Button
                x:Name="AddEndpointButton"
                Margin="0,4,0,0"
                Content="{local:T Text='Add Endpoint'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
