<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings › About (macOS SettingsWindow.swift AboutSettingsView): the logo, name and version, the license, the GitHub
    link, and the data folder with "Open in File Explorer" (macOS has it in Storage), as Windows 11 Settings cards. Each
    searchable card's Tag is its search entry's title (SearchEntries).
-->
<UserControl
    x:Class="EchoDiar.App.Views.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:EchoDiar.App">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Margin="24,12,24,24"
            Spacing="4">

            <controls:SettingsCard
                x:Name="VersionCard"
                Header="{local:T Text='EchoDiar'}"
                Tag="Version">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/Square44x44Logo.png" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="{local:T Text='Licensed under AGPL-3.0'}"
                Tag="Licensed under AGPL-3.0">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8A5;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="RepositoryCard"
                Header="{local:T Text='github.com/dinhanhthi/EchoDiar'}"
                IsClickEnabled="True"
                Tag="github.com/dinhanhthi/EchoDiar">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71B;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.ActionIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" />
                </controls:SettingsCard.ActionIcon>
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="{local:T Text='Data folder'}"
                Tag="Data folder">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Description>
                    <TextBlock
                        x:Name="DataFolderText"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <Button x:Name="OpenFolderButton" Content="{local:T Text='Open in File Explorer'}" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
