<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings › Storage (macOS StorageSettingsView.swift), one panel per inner tab picked in the title bar:
    - Usage: disk usage by kind (a bar in the theme's attention, success and caution colours, then Audio, Transcripts
      and AI, Models and Total), and the data folder with "Open in File Explorer".
    - Audio: compression bitrate, keep uncompressed audio, playback.
    Phase 16 adds the Auto-delete tab and the rest of the macOS page: the delete buttons by kind, Largest conversations,
    Free space and Delete audio after transcription. Each searchable card's Tag is its search entry's title
    (SearchEntries), so a search result can bring it into view.
-->
<UserControl
    x:Class="EchoDiar.App.Views.StorageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <Style x:Key="DotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SizeStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid MaxWidth="1000" Margin="24,12,24,24">

            <!-- Usage -->
            <StackPanel x:Name="UsagePanel" Spacing="4">

                <!-- The bar on a card's surface; the parts' widths and end corners are set in code (UpdateUsage). -->
                <Border
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid>
                        <ProgressRing
                            x:Name="UsageRing"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            IsActive="True" />
                        <Grid
                            x:Name="UsageBar"
                            Height="10"
                            Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                            CornerRadius="5"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AudioColumn" Width="0" />
                                <ColumnDefinition x:Name="TranscriptsColumn" Width="0" />
                                <ColumnDefinition x:Name="ModelsColumn" Width="0" />
                                <ColumnDefinition x:Name="FreeColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="AudioPart"
                                Grid.Column="0"
                                Background="{ThemeResource SystemFillColorAttentionBrush}" />
                            <Border
                                x:Name="TranscriptsPart"
                                Grid.Column="1"
                                Background="{ThemeResource SystemFillColorSuccessBrush}" />
                            <Border
                                x:Name="ModelsPart"
                                Grid.Column="2"
                                Background="{ThemeResource SystemFillColorCautionBrush}" />
                        </Grid>
                    </Grid>
                </Border>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Fill="{ThemeResource SystemFillColorAttentionBrush}" Style="{StaticResource DotStyle}" />
                            <TextBlock Text="{local:T Text='Audio'}" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <TextBlock x:Name="AudioSizeText" Style="{StaticResource SizeStyle}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" Style="{StaticResource DotStyle}" />
                            <TextBlock Text="{local:T Text='Transcripts and AI'}" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <TextBlock x:Name="TranscriptsSizeText" Style="{StaticResource SizeStyle}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" Style="{StaticResource DotStyle}" />
                            <TextBlock Text="{local:T Text='Models'}" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <TextBlock x:Name="ModelsSizeText" Style="{StaticResource SizeStyle}" />
                </controls:SettingsCard>

                <controls:SettingsCard Tag="Total">
                    <controls:SettingsCard.Header>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Total'}" />
                    </controls:SettingsCard.Header>
                    <TextBlock
                        x:Name="TotalSizeText"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Margin="0,24,0,0"
                    Header="{local:T Text='Data folder'}"
                    Tag="Data folder">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Description>
                        <TextBlock
                            x:Name="DataFolderText"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <Button x:Name="OpenFolderButton" Content="{local:T Text='Open in File Explorer'}" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- Audio -->
            <StackPanel
                x:Name="AudioPanel"
                Spacing="4"
                Visibility="Collapsed">

                <controls:SettingsCard
                    Header="{local:T Text='Compression bitrate'}"
                    Tag="Compression bitrate">
                    <ComboBox
                        x:Name="BitrateCombo"
                        MinWidth="200"
                        AutomationProperties.Name="{local:T Text='Compression bitrate'}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="{local:T Text='Keeps the original CAF next to the compressed file (about 10 times larger).'}"
                    Header="{local:T Text='Keep uncompressed audio'}"
                    Tag="Keep uncompressed audio">
                    <ToggleSwitch x:Name="KeepUncompressedToggle" AutomationProperties.Name="{local:T Text='Keep uncompressed audio'}" />
                </controls:SettingsCard>

                <!-- Description in code: the text has an apostrophe. -->
                <controls:SettingsCard
                    x:Name="PlaybackCard"
                    Header="{local:T Text='Playback'}"
                    Tag="Playback">
                    <ComboBox
                        x:Name="PlaybackCombo"
                        MinWidth="200"
                        AutomationProperties.Name="{local:T Text='Playback'}">
                        <ComboBoxItem Content="{local:T Text='Both voices in both ears'}" />
                        <ComboBoxItem Content="{local:T Text='My voice left, others right'}" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
