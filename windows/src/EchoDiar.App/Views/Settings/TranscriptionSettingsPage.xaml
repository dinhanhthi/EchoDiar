<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings › Transcription (macOS ModelsSettingsView.swift), one page without inner tabs:
    - General: default language, remember last record language, transcribe while recording, free unused models after,
      delete audio after transcription (the same setting as Storage › Audio). Transcribe automatically and waiting while
      energy saver is on are in Recording › After recording, as on macOS.
    - Transcription model: the default transcription model (DefaultEnginePicker), then, when it is a cloud engine, its
      "While recording" group (live with a local model, or with its realtime stream, and using the realtime result as
      the transcript), greyed while a master switch is off; both made in code (TranscriptionModelList).
    - Speakers: tell speakers apart, the number of other speakers, the default diarization model (made in code).
    The local models are downloaded in AI Providers › Local AI; the cloud engines are set up in AI Providers › Cloud.
    Each searchable element's Tag is its search entry's title (SearchEntries), so a search result can bring it into view.
-->
<UserControl
    x:Class="EchoDiar.App.Views.TranscriptionSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:EchoDiar.App">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="1,24,0,4" />
            <Setter Property="Spacing" Value="2" />
        </Style>
        <!-- The parts made in code (the default engine pickers, the "While recording" group), in theme colours. -->
        <Style
            x:Key="NoteStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="CautionNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style
            x:Key="CriticalNoteStyle"
            BasedOn="{StaticResource NoteStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="CautionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Margin="24,12,24,24"
            Spacing="4">

            <!-- General (macOS generalSection) -->
            <controls:SettingsCard Header="{local:T Text='Default language'}" Tag="Default language">
                <ComboBox
                    x:Name="LanguageCombo"
                    MinWidth="200"
                    AutomationProperties.Name="{local:T Text='Default language'}" />
            </controls:SettingsCard>

            <!-- The description is set in code (its apostrophe can't go in a {local:T} text). -->
            <controls:SettingsCard
                x:Name="RememberLanguageCard"
                Header="{local:T Text='Remember last record language'}"
                Tag="Remember last record language">
                <ToggleSwitch x:Name="RememberLanguageToggle" AutomationProperties.Name="{local:T Text='Remember last record language'}" />
            </controls:SettingsCard>

            <!-- The description is set in code (Windows text). -->
            <controls:SettingsCard
                x:Name="LiveCard"
                Header="{local:T Text='Transcribe while recording'}"
                Tag="Transcribe while recording">
                <ToggleSwitch x:Name="LiveToggle" AutomationProperties.Name="{local:T Text='Transcribe while recording'}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="{local:T Text='While a recording stays paused this long, the model that transcribes it is freed; it loads again when you resume. Other models are freed as soon as their job ends.'}"
                Header="{local:T Text='Free unused models after'}"
                Tag="Free unused models after">
                <ComboBox
                    x:Name="IdleCombo"
                    MinWidth="120"
                    AutomationProperties.Name="{local:T Text='Free unused models after'}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="{local:T Text='Moves the audio to the Recycle Bin once a transcription succeeds.'}"
                Header="{local:T Text='Delete audio after transcription'}"
                Tag="Delete audio after transcription">
                <ToggleSwitch x:Name="DeleteAfterToggle" AutomationProperties.Name="{local:T Text='Delete audio after transcription'}" />
            </controls:SettingsCard>

            <!-- Transcription model: the default engine picker, then the default cloud engine's "While recording" group (made in code). -->
            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Transcription model'}" />
            </StackPanel>
            <StackPanel x:Name="TranscriptionModelList" Spacing="4" />

            <!-- Speakers -->
            <StackPanel Style="{StaticResource SectionHeaderStyle}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:T Text='Speakers'}" />
            </StackPanel>
            <controls:SettingsCard
                Description="{local:T Text='Labels each voice in the meeting audio: Speaker 1, 2, … Off: the meeting audio is one speaker.'}"
                Header="{local:T Text='Tell speakers apart'}"
                Tag="Tell speakers apart">
                <ToggleSwitch x:Name="DiarizationToggle" AutomationProperties.Name="{local:T Text='Tell speakers apart'}" />
            </controls:SettingsCard>

            <!-- Shown while Tell speakers apart is on; the description depends on the speaker model (set in code). -->
            <controls:SettingsCard
                x:Name="SpeakerCountCard"
                Header="{local:T Text='Number of other speakers'}"
                Tag="Number of other speakers">
                <ComboBox
                    x:Name="SpeakerCountCombo"
                    MinWidth="120"
                    AutomationProperties.Name="{local:T Text='Number of other speakers'}" />
            </controls:SettingsCard>

            <!-- The default diarization model's picker (made in code). -->
            <StackPanel x:Name="DiarizationModelList" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
