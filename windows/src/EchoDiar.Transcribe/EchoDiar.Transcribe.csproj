<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EchoDiar.Transcribe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EchoDiar.Core\EchoDiar.Core.csproj" />
    <!-- Cloud speech-to-text (Phase 26): the cloud transcribers and the audio export contract. -->
    <ProjectReference Include="..\EchoDiar.AI\EchoDiar.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
  </ItemGroup>

  <ItemGroup>
    <!-- Silero VAD 6.2.1 (MIT) for the Whisper speech gate, one file for every architecture. Copied to the output of
         every project that references this one, so it reaches the App's MSIX and the tests.
         Source: https://github.com/snakers4/silero-vad/raw/v6.2.1/src/silero_vad/data/silero_vad.onnx (tag v6.2.1)
         SHA-256: 1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3 (2,327,524 bytes) -->
    <Content Include="Models\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EchoDiar.Tests" />
  </ItemGroup>
</Project>
