<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- .NET Framework 4.8 is in-box on every Windows 10/11: one AnyCPU exe runs natively on x64 and ARM64. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EchoDiar-Setup</AssemblyName>
    <RootNamespace>EchoDiar.Setup</RootNamespace>
    <!-- net48's implicit usings include System.Net.Http, which net48 does not reference. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>..\EchoDiar.App\Assets\EchoDiar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Build inputs: -p:SetupFeedUri=<uri> (the App Installer feed Setup installs from) and -p:SetupCertificate=<path>
       (the public .cer Setup trusts, embedded as the resource EchoDiar.cer; a relative path is resolved against this
       folder). A Release build needs the certificate. -->
  <PropertyGroup>
    <SetupFeedUri Condition="'$(SetupFeedUri)' == ''">https://ed.dinhanhthi.com/windows/EchoDiar.appinstaller</SetupFeedUri>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SetupFeedUri</_Parameter1>
      <_Parameter2>$(SetupFeedUri)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(SetupCertificate)' != ''">
    <EmbeddedResource Include="$(SetupCertificate)" LogicalName="EchoDiar.cer" />
  </ItemGroup>

  <Target Name="CheckSetupCertificate" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(SetupCertificate)' == '' or !Exists('$(SetupCertificate)')"
           Text="A Release build of EchoDiar.Setup needs -p:SetupCertificate=&lt;path to the release .cer&gt; (got '$(SetupCertificate)')." />
  </Target>

  <ItemGroup>
    <!-- WinRT PackageManager (AddPackageByUriAsync, AddPackageByAppInstallerFileAsync) from .NET Framework. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" />
  </ItemGroup>
</Project>
