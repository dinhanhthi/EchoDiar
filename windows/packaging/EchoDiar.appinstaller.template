<?xml version="1.0" encoding="utf-8"?>
<!--
  App Installer feed for EchoDiar (Windows). Rendered by .github/workflows/windows-release.yml (and by the local
  test feed script windows/scripts/serve-update.sh), which replace each placeholder: the 4-part package version
  (tag vX.Y.Z or windows-vX.Y.Z-dev gives X.Y.Z.0), the signing certificate subject (= the Identity
  Publisher of Package.appxmanifest), the address of this file itself (App Installer always reads the feed from
  there; on the dev channel it is the prerelease's own asset) and the address of the .msixbundle (the GitHub release
  asset of the tag). Never edit a rendered copy by hand.
  The app prompts before it updates (Updater.cs), so App Installer shows no prompt of its own (no ShowPrompt).
  App Installer may also install an update on its own while the app is not running (OnLaunch checks at each launch,
  AutomaticBackgroundTask every 8 hours), silently: there is no in-app prompt then.
-->
<AppInstaller
  xmlns="http://schemas.microsoft.com/appx/appinstaller/2018"
  Version="@VERSION@"
  Uri="@APPINSTALLER_URI@">

  <MainBundle
    Name="dinh.thi.EchoDiar"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    Uri="@BUNDLE_URI@" />

  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="0" />
    <AutomaticBackgroundTask />
  </UpdateSettings>
</AppInstaller>
