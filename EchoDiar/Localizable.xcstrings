    "%@ cannot be recorded on its own: all system audio will be recorded." : {
      "comment" : "A label that explains that the app needs global tap to record.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se puede grabar por separado: se grabará todo el audio del sistema."
          }
