      "comment" : "A label that appears when the test fails because the user's microphone is muted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EchoDiar solo ha oído silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "EchoDiar n’a entendu que du silence."
          }
        },
        "vi" : {
