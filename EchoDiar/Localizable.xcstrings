    "Transcription turns speech into text. The transcription model listens to the recording and writes what was said, with timestamps." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcripción convierte la voz en texto. El modelo de transcripción escucha la grabación y escribe lo que se dijo, con marcas de tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La transcription convertit la parole en texte. Le modèle de transcription écoute l’enregistrement et écrit ce qui a été dit, avec des horodatages."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chép lời chuyển giọng nói thành văn bản. Mô hình chép lời nghe bản ghi âm và viết lại những gì đã nói, kèm dấu thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转写会将语音转换为文字。转写模型会聆听录音，并写下所说的内容和时间戳。"
          }
        }
      }
    },
