    "Diarization finds who spoke when. The diarization model tells the voices apart and labels each part of the transcript with its speaker." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diarización averigua quién habló y cuándo. El modelo de diarización distingue las voces y etiqueta cada parte de la transcripción con su hablante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La diarisation identifie qui a parlé et quand. Le modèle de diarisation distingue les voix et attribue chaque partie de la transcription à son intervenant."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Phân biệt người nói cho biết ai nói khi nào. Mô hình phân biệt người nói tách các giọng nói và gắn nhãn người nói cho từng phần của bản chép lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说话人分离会找出谁在何时说话。说话人分离模型会区分不同的声音，并为转写文本的每个部分标注说话人。"
          }
        }
      }
    },
